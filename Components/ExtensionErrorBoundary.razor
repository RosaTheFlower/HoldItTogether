@inherits ErrorBoundaryBase
@inject Microsoft.Extensions.Logging.ILogger<ExtensionErrorBoundary> Logger
@using Microsoft.Extensions.Logging
@using HIT.Sdk

@if (CurrentException is null)
{
    @ChildContent
}
else
{
    @ErrorContent?.Invoke(CurrentException)
}

@code {
    [Parameter] public IHitApi? Api { get; set; }
    [Parameter] public EventCallback<Exception> OnFailure { get; set; }

    protected override async Task OnErrorAsync(Exception exception)
    {
        Logger.LogError(exception, "An extension menu failed to render.");
        try { Api?.Log("Menu render failure: " + exception); }
        catch (Exception logError) when (logError is IOException or UnauthorizedAccessException) { }
        await OnFailure.InvokeAsync(exception);
    }
}
