@using HoldItTogether.Services.Settings
@using HoldItTogether.Services.Themes
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject HitSettingsService Settings
@inject HitThemeService Themes
@inject HitAppearanceService Appearance
@inject IJSRuntime JS
@inject HoldItTogether.Services.DesktopWindowService Desktop
@inject HoldItTogether.Services.Diagnostics.HitResourcePolicy Resources
@inject HoldItTogether.Services.Extensions.HitExtensionHub ExtensionHub

@code {
    private IJSObjectReference? _module;
    private IJSObjectReference? _icons;
    private DotNetObjectReference<HitThemeManager>? _reference;
    [JSInvokable] public void SetApplicationIcon(string png){if(!_disposed)Desktop.SetApplicationIcon(png);}
    [JSInvokable] public void PublishAppearanceTokens(Dictionary<string,string> tokens,bool systemReducedMotion){if(!_disposed)ExtensionHub.PublishTokens(tokens,systemReducedMotion);}
    private readonly CancellationTokenSource _lifetime = new();
    private Task? _monitor;
    private string? _revision;
    private HitAppearancePreferences? _appearance;
    private bool? _gifBackgroundsAllowed;
    private string? _baseRevision;
    private bool? _motionDisabled;
    private bool? _tooltipsEnabled;
    private bool _disposed;
    private bool _applying, _applyRequested;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/hit-themes.js");
        if (_disposed) { await _module.DisposeAsync(); return; }
        _icons=await JS.InvokeAsync<IJSObjectReference>("import","./js/hit-app-icon.js");
        _reference=DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("watchAppearance",_reference);
        Settings.Changed += OnSettingsChanged;
        Appearance.Changed += OnSettingsChanged;
        Resources.Changed += OnResourceStateChanged;
        await ApplyAsync();
        _monitor = MonitorAsync(_lifetime.Token);
    }

    private void OnSettingsChanged()
    {
        if (!_disposed) _ = InvokeAsync(ApplyAsync);
    }
    private void OnResourceStateChanged()
    {
        if (!_disposed && !Resources.IsSleeping) _ = InvokeAsync(ApplyAsync);
    }

    private async Task ApplyAsync()
    {
        if (_applying) { _applyRequested = true; return; }
        _applying = true;
        try
        {
            do { _applyRequested = false; await ApplyCoreAsync(); }
            while (_applyRequested && !_disposed);
        }
        finally { _applying = false; }
    }

    private async Task ApplyCoreAsync()
    {
        if (_disposed || _module is null) return;
        if (_tooltipsEnabled != Settings.Current.ShowTooltips)
        {
            await _module.InvokeVoidAsync("setTooltips", Settings.Current.ShowTooltips);
            _tooltipsEnabled = Settings.Current.ShowTooltips;
        }
        var motionDisabled = Settings.Current.RemoveAnimations;
        if (_motionDisabled != motionDisabled)
        {
            await _module.InvokeVoidAsync("setMotion", motionDisabled);
            _motionDisabled = motionDisabled;
        }
        var baseline = Themes.ReadBase();
        if (baseline.Revision != _baseRevision)
        {
            await _module.InvokeVoidAsync("applyBase", baseline.Css);
            _baseRevision = baseline.Revision;
        }
        var snapshot = Themes.ReadCurrent(Appearance.PreviewTheme);
        var changed=false;
        if (snapshot.Revision != _revision)
        {
            // JS validates and replaces the stylesheet atomically; malformed themes keep the last valid CSS.
            Themes.RuntimeError = await _module.InvokeAsync<string?>("apply", snapshot.Css == baseline.Css ? "" : snapshot.Css, snapshot.Error);
            _revision = snapshot.Revision;
            changed=true;
        }
        if(_appearance!=Appearance.Current || _gifBackgroundsAllowed!=Appearance.GifBackgroundsAllowed)
        {
            _gifBackgroundsAllowed=Appearance.GifBackgroundsAllowed;
            _appearance=Appearance.Current;
            await _module.InvokeVoidAsync("applyAppearance",Appearance.Css(_appearance));changed=true;
        }
        if(changed&&_icons is not null)await _icons.InvokeVoidAsync("sync",_reference);
    }

    private async Task MonitorAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
                if (!Resources.IsSleeping) await InvokeAsync(ApplyAsync);
        }
        catch (OperationCanceledException) { }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Settings.Changed -= OnSettingsChanged;
        Appearance.Changed -= OnSettingsChanged;
        Resources.Changed -= OnResourceStateChanged;
        _lifetime.Cancel();
        if (_monitor is not null) await _monitor;
        _lifetime.Dispose();
        _reference?.Dispose();
        if(_icons is not null){try{await _icons.DisposeAsync();}catch(JSDisconnectedException){}}
        if (_module is not null)
        {
            try{await _module.InvokeVoidAsync("unwatchAppearance");}catch(JSDisconnectedException){}
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
