@using System.Globalization
@using System.Runtime.InteropServices
@using HoldItTogether.Services.Audio
@using HoldItTogether.Services.HitMenus
@using HoldItTogether.Components.Audio
@using Microsoft.JSInterop
@attribute [HitMenuTitle("Áudio")]
@implements IAsyncDisposable
@implements IHitMenuSettings
@inject IHitMediaService Media
@inject AudioSpectrumService Spectrum
@inject IJSRuntime JS
@inject LyricsService Lyrics
@inject HoldItTogether.Services.Settings.HitSettingsService Settings

<HitMenuViewport ScaleX="@(_showSettings ? 100 : Settings.Current.AudioScaleX)" ScaleY="@(_showSettings ? 100 : Settings.Current.AudioScaleY)">
<div @ref="_root" class="audio-menu @(!_snapshot.HasMedia ? "is-empty" : "") @(_artworkMode ? "is-artwork" : "") @(_showLyrics ? "is-lyrics" : "") @(_showAppearance ? "is-customizing" : "") @(_showSettings ? "is-menu-settings" : "") @(!Settings.Current.AudioShowSource ? "hide-source" : "") @(_showVisualizer ? "has-spectrum" : "")"
     data-hit-hide-controls="@(Settings.Current.AudioHideControls && !_showSettings && !_showAppearance ? "true" : "false")"
     data-hit-view="@(_showSettings ? "settings" : _showAppearance ? "appearance" : _showLyrics ? "lyrics" : "player")"
     data-audio-lyrics-cover="@(Settings.Current.AudioArtworkLyricsCover ? "true" : null)"
     @onclick:stopPropagation="true" @onkeydown="HandleKey" @onkeydown:stopPropagation="true" @oncontextmenu:preventDefault="true">
    <div class="audio-scene" aria-hidden="true">
        <div class="audio-artwork-wash"></div>
        <div class="audio-artwork-veil"></div>
        @if (_showVisualizer)
        {
            <div id="audio-background-spectrum" @ref="_spectrumElement" class="audio-spectrum">
                @for (var band = 0; band < AudioSpectrumAnalyzer.BandCount; band++)
                {
                    <span class="spectrum-bar"></span>
                }
            </div>
        }
    </div>

    @if (_showSettings)
    {
        <AudioSettingsView Settings="@Settings.Current" Error="@_appearanceError" SizeChanged="SetAudioSize"
                           HideControlsChanged="SetHideControls" ShowSourceChanged="SetShowSource" BackRequested="ReturnToPlayerAsync" />
    }
    <div class="audio-player-shell" hidden="@_showSettings">
    @if (_showLyrics && _visible)
    {
        <div class="audio-overlay-view">
        <AudioLyricsView Generation="@_snapshot.Generation" Lyrics="@_lyrics" Position="@(_seekPreview ?? _snapshot.Position)"
                         CanSeek="@_snapshot.CanSeek" Busy="@_busy" Loading="@_lyricsLoading"
                         SeekRequested="SeekLyricAsync" BackRequested="ReturnToPlayerAsync" />
        </div>
    }
    @if (_showAppearance)
    {
        <div class="audio-overlay-view">
            <AudioAppearanceView Blur="@ArtworkBlur" GlobalAccent="@Settings.Current.AudioArtworkGlobalAccent" GlobalCover="@Settings.Current.AudioArtworkGlobalCover"
                                 LyricsCover="@Settings.Current.AudioArtworkLyricsCover" LyricsCoverChanged="SetLyricsArtworkCover"
                                 BlurPreview="PreviewArtworkBlur" BlurChanged="SaveArtworkBlur" GlobalAccentChanged="SetGlobalArtworkAccent"
                                 GlobalCoverChanged="SetGlobalArtworkCover" BackRequested="ReturnToPlayerAsync" Error="@_appearanceError" />
        </div>
    }
    <div class="audio-player-content @(_showLyrics || _showAppearance ? "is-obscured" : "")"
         inert="@(_showLyrics || _showAppearance)" aria-hidden="@(_showLyrics || _showAppearance ? "true" : "false")">
        <div class="audio-track">
        <div class="audio-cover" aria-hidden="true">
            @if (_snapshot.Artwork is { } artwork)
            {
                <img src="@(_visible ? artwork : null)" alt="" draggable="false" />
            }
            else
            {
                <svg viewBox="0 0 32 32" focusable="false"><path d="M12 23V9l14-3v14M12 13l14-3" /><ellipse cx="8" cy="24" rx="4" ry="3" /><ellipse cx="22" cy="21" rx="4" ry="3" /></svg>
            }
        </div>
        <div class="audio-metadata">
            <p class="audio-source"><span class="audio-status @(_snapshot.Playing ? "is-playing" : "")"></span>@(_snapshot.HasMedia ? _snapshot.Source : "ÁUDIO DO SISTEMA")</p>
            <h2 class="audio-title" title="@(_snapshot.HasMedia ? _snapshot.Title + " · Ctrl + clique para abrir o aplicativo" : _snapshot.Title)"
                data-ctrl-link="@(_snapshot.HasMedia ? "true" : null)" tabindex="@(_snapshot.HasMedia ? 0 : -1)"
                @onclick="ActivateSourceAsync" @onkeydown="HandleSongKeyAsync">@_snapshot.Title</h2>
            <p class="audio-artist" title="@_snapshot.Artist">@_snapshot.Artist</p>
        </div>
    </div>

    <div class="audio-progress" data-no-drag>
        <input class="audio-timeline" type="range" min="0" max="@Number(Math.Max(1, _snapshot.Duration))" step="0.1"
               value="@Number(_seekPreview ?? _snapshot.Position)" style="@($"--audio-progress:{Number(Progress)}%")"
               aria-label="Posição da reprodução" aria-valuetext="@($"{Time(_seekPreview ?? _snapshot.Position)} de {Time(_snapshot.Duration)}")"
               disabled="@(_busy || !_snapshot.CanSeek)" @oninput="PreviewSeek" @onchange="CommitSeekAsync"
               @onwheel:stopPropagation="true" />
        <div class="audio-times">
            <span>@(_snapshot.Duration > 0 ? Time(_seekPreview ?? _snapshot.Position) : "--:--")</span>
            <span>@(_snapshot.Duration > 0 ? Time(_snapshot.Duration) : "--:--")</span>
        </div>
    </div>

    <div class="audio-toolbar" data-no-drag>
        <button type="button" class="audio-control audio-shuffle @(_snapshot.Shuffle ? "is-active" : "")"
                aria-label="@(_snapshot.Shuffle ? "Desativar ordem aleatória" : "Ativar ordem aleatória")"
                title="@(_snapshot.CanShuffle ? "Ordem aleatória" : "Este aplicativo não oferece ordem aleatória")"
                aria-pressed="@(_snapshot.Shuffle ? "true" : "false")" disabled="@(_busy || !_snapshot.CanShuffle)"
                @onclick="() => CommandAsync(MediaAction.ToggleShuffle)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h3c5 0 7 12 12 12h3m-4-4 4 4-4 4M3 18h3c2 0 3-2 5-5m2-2c2-3 3-5 5-5h3m-4-4 4 4-4 4" /></svg>
        </button>
        <div class="audio-transport">
            <button type="button" class="audio-control" aria-label="Faixa anterior" title="Anterior"
                    disabled="@(_busy || !_snapshot.CanPrevious)" @onclick="() => CommandAsync(MediaAction.Previous)">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5v14" /><path class="audio-glyph" d="m19 5-11 7 11 7Z" /></svg>
            </button>
            <button type="button" class="audio-control audio-play" aria-label="@(_snapshot.Playing ? "Pausar" : "Reproduzir")"
                    title="@(_snapshot.Playing ? "Pausar" : "Reproduzir")"
                    disabled="@(_busy || !_snapshot.CanToggle)" @onclick="() => CommandAsync(MediaAction.TogglePlayback)">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    @if (_snapshot.Playing) { <path class="audio-glyph" d="M7 5h3v14H7Zm7 0h3v14h-3Z" /> }
                    else { <path class="audio-glyph" d="m8 4 12 8-12 8Z" /> }
                </svg>
            </button>
            <button type="button" class="audio-control" aria-label="Próxima faixa" title="Próxima"
                    disabled="@(_busy || !_snapshot.CanNext)" @onclick="() => CommandAsync(MediaAction.Next)">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 5v14" /><path class="audio-glyph" d="m5 5 11 7-11 7Z" /></svg>
            </button>
        </div>
        <button type="button" class="audio-control audio-loop @(_snapshot.Loop != MediaLoop.Off ? "is-active" : "")"
                aria-label="@LoopLabel" title="@(_snapshot.CanLoop ? LoopLabel : "Este aplicativo não oferece controle de loop")"
                aria-pressed="@(_snapshot.Loop != MediaLoop.Off ? "true" : "false")"
                disabled="@(_busy || !_snapshot.CanLoop)" @onclick="() => CommandAsync(MediaAction.ToggleLoop)">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m17 2 4 4-4 4M3 11V9a3 3 0 0 1 3-3h15M7 22l-4-4 4-4m14-1v2a3 3 0 0 1-3 3H3" /></svg>
            @if (_snapshot.Loop == MediaLoop.Track) { <span class="audio-loop-one" aria-hidden="true">1</span> }
        </button>
    </div>

    <div class="hit-idle-collapse" data-hit-collapse="player"><div class="hit-idle-collapse-content">
    <div class="audio-tools" data-no-drag data-hit-idle-controls>
        <button type="button" class="audio-control audio-secondary audio-artwork-toggle @(_artworkMode ? "is-active" : "")"
                aria-label="Modo capa e cores" title="Modo capa e cores · M2 para personalizar" data-hit-menu-trigger="appearance"
                aria-pressed="@(_artworkMode ? "true" : "false")"
                @onclick="ToggleArtwork" @oncontextmenu="OpenAppearance" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true" @onpointerup="HandleArtworkPointerUp">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3" /><circle cx="8" cy="9" r="1.5" /><path d="m4 17 5-5 4 4 3-3 5 5" /></svg>
        </button>
        <div class="audio-tool-group">
            <button type="button" class="audio-control audio-secondary @(_showLyrics ? "is-active" : "")"
                    aria-label="Letras sincronizadas" title="@(_lyricsLoading ? "Buscando letra sincronizada…" : _lyrics is null ? "Letra sincronizada não encontrada" : "Mostrar letras sincronizadas")"
                    aria-expanded="@(_showLyrics ? "true" : "false")" aria-controls="audio-lyrics-view"
                    disabled="@(_lyrics is null)" @onclick="ToggleLyrics">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14v13H9l-4 3Zm4 4h6m-6 4h4" /></svg>
            </button>
<button type="button" class="audio-control audio-secondary audio-visualizer-toggle @(_showVisualizer ? "is-active" : "")"
                aria-label="@(_showVisualizer ? "Ocultar visualizador de áudio" : "Mostrar visualizador de áudio")"
                title="Visualizador de áudio"
                aria-pressed="@(_showVisualizer ? "true" : "false")" aria-controls="audio-background-spectrum" @onclick="ToggleVisualizer">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10v4m4-9v14m4-12v10m4-14v18m4-11v4" /></svg>
        </button>
        </div>
    </div>

    </div></div>
        </div>
    @if (_visualizerError is { } visualizerError) { <p class="audio-error" role="status">@visualizerError</p> }
    @if ((_actionError ?? _connectionError) is { } error) { <p class="audio-error" role="status">@error</p> }
    </div>
</div>
</HitMenuViewport>
@code {
    [CascadingParameter(Name = "HitMenu")] public HitMenuContext? MenuContext { get; set; }
    private MediaSnapshot _snapshot = MediaSnapshot.Empty;
    private readonly CancellationTokenSource _lifetime = new();
    private CancellationTokenSource? _monitorCts, _spectrumCts;
    private Task? _monitorTask, _spectrumTask;
    private IJSObjectReference? _module;
    private Task<IJSObjectReference>? _moduleLoad;
    private ElementReference _spectrumElement;
    private ElementReference _root;
    private SceneState? _scene;
    private string? _sceneArtwork;
    private int _sceneVersion;
    private string? _publishedTitle;
    private sealed record SceneState(string? Artwork, bool Enabled, bool Visible, bool Lyrics, bool Customizing, int Blur, bool Global, bool Cover);
    private bool _artworkMode, _showLyrics, _showAppearance, _showSettings, _lyricsLoading;
    private SyncedLyrics? _lyrics;
    private string? _lyricsKey, _appearanceError;
    private DateTimeOffset _lastLyricsLookup;
    private CancellationTokenSource? _lyricsCts;
    private Task? _lyricsTask;
    private bool _visible, _disposed, _busy, _showVisualizer, _visualizerFailed;
    private string? _connectionError, _actionError, _visualizerError;
    private double? _seekPreview;
    private long? _seekGeneration;

    private int? _blurPreview;
    private int ArtworkBlur => _blurPreview ?? Settings.Current.AudioArtworkBlur;
    private bool ShouldMonitor => _visible || (_artworkMode && Settings.Current.AudioArtworkGlobalAccent);

    protected override void OnInitialized()
    {
        _artworkMode = Settings.Current.AudioArtworkMode;
        Settings.Changed += OnSettingsChanged;
    }

    private void OnSettingsChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            _artworkMode = Settings.Current.AudioArtworkMode;
            if (!ShouldMonitor) _monitorCts?.Cancel();
            StateHasChanged();
        });
    }

    private double Progress => _snapshot.Duration > 0 ? Math.Clamp((_seekPreview ?? _snapshot.Position) / _snapshot.Duration * 100, 0, 100) : 0;
    private string LoopLabel => _snapshot.Loop switch { MediaLoop.Track => "Desativar loop da faixa", MediaLoop.List => "Desativar loop da lista", _ => "Repetir faixa" };
    private static string Number(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
    private static string Time(double value)
    {
        var time = TimeSpan.FromSeconds(Math.Max(0, value));
        return time.TotalHours >= 1 ? $"{(int)time.TotalHours}:{time.Minutes:00}:{time.Seconds:00}" : $"{(int)time.TotalMinutes}:{time.Seconds:00}";
    }

    protected override void OnParametersSet()
    {
        _visible = (MenuContext?.IsActive ?? true) && (MenuContext?.IsVisible ?? true);
        if (!_visible)
        {
            if (!ShouldMonitor) _monitorCts?.Cancel();
            _spectrumCts?.Cancel();
            _lyricsCts?.Cancel();
            _seekPreview = null;
            _seekGeneration = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || (_module is null && !ShouldMonitor)) return;
        _moduleLoad ??= JS.InvokeAsync<IJSObjectReference>("import", "./js/audio-player.js").AsTask();
        _module = await _moduleLoad;
        if (_disposed) return;
        var scene = new SceneState(_artworkMode ? _snapshot.Artwork : null, _artworkMode, _visible, _showLyrics, _showAppearance || _showSettings, ArtworkBlur, Settings.Current.AudioArtworkGlobalAccent, Settings.Current.AudioArtworkGlobalCover);
        if (scene != _scene)
        {
            _scene = scene;
            var version = ++_sceneVersion;
            var reuseArtwork = scene.Enabled && scene.Artwork is not null && scene.Artwork == _sceneArtwork;
            if (!scene.Enabled || (!scene.Visible && !scene.Global)) _sceneArtwork = null;
            await _module.InvokeVoidAsync("syncScene", _root, reuseArtwork ? null : scene.Artwork, scene.Enabled, scene.Visible, scene.Lyrics,
                new { blur = scene.Blur, @global = scene.Global, cover = scene.Cover, customizing = scene.Customizing, reuseArtwork });
            if (version == _sceneVersion && scene.Enabled && (scene.Visible || scene.Global)) _sceneArtwork = scene.Artwork;
        }
        if (_monitorTask is null && ShouldMonitor)
        {
            _monitorCts = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
            _monitorTask = MonitorAsync(_monitorCts.Token);
        }
        if (!_visible) { _publishedTitle = null; return; }
        var title = _showSettings ? "Configurações de áudio" : _showAppearance ? "Tema da música" : _showLyrics ? "Letras" : "Áudio";
        if (_publishedTitle != title)
        {
            _publishedTitle = title;
            if (MenuContext is not null) await MenuContext.TitleRequested.InvokeAsync(title);
        }
        if (_showVisualizer && !_visualizerFailed && _spectrumTask is null)
        {
            _spectrumCts = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
            _spectrumTask = VisualizeAsync(_spectrumCts.Token);
        }
    }

    private async Task RefreshAsync(CancellationToken token)
    {
        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(token);
        timeout.CancelAfter(TimeSpan.FromSeconds(4));
        var snapshot = await Media.ReadAsync(timeout.Token);
        await InvokeAsync(() =>
        {
            if (_disposed || token.IsCancellationRequested) return;
            if (_snapshot.Generation != snapshot.Generation)
            {
                _seekPreview = null;
                _actionError = null;
            }
            var changed = _snapshot != snapshot || _connectionError is not null;
            _snapshot = snapshot;
            var lyricsChanged = _visible && BeginLyricsLookup(snapshot);
            _connectionError = null;
            if (changed || lyricsChanged) StateHasChanged();
        });
    }

    private async Task MonitorAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(500));
        var hiddenTick = 0;
        try
        {
            do
            {
                if (!_visible && ++hiddenTick % 4 != 0) continue;
                if (!_busy)
                {
                    try { await RefreshAsync(token); }
                    catch (OperationCanceledException) when (token.IsCancellationRequested) { break; }
                    catch (Exception error) when (error is COMException or UnauthorizedAccessException or InvalidOperationException or OperationCanceledException)
                    {
                        await InvokeAsync(() =>
                        {
                            if (_disposed) return;
                            _snapshot = MediaSnapshot.Empty;
                            _connectionError = "Não foi possível acessar a mídia do Windows. Tentando novamente…";
                            StateHasChanged();
                        });
                    }
                }
            } while (await timer.WaitForNextTickAsync(token));
        }
        catch (OperationCanceledException) { }
        finally
        {
            if (!ShouldMonitor)
            {
                await Media.ReleaseArtworkAsync();
                await InvokeAsync(() =>
                {
                    if (!ShouldMonitor) { _snapshot = _snapshot with { Artwork = null }; _sceneArtwork = null; }
                });
            }
            _monitorCts?.Dispose();
            _monitorCts = null;
            _monitorTask = null;
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CommandAsync(MediaAction action, double position = 0, long? generation = null)
    {
        if (_busy || _disposed) return;
        _busy = true;
        _actionError = null;
        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        timeout.CancelAfter(TimeSpan.FromSeconds(4));
        try
        {
            var accepted = await Media.ExecuteAsync(action, generation ?? _snapshot.Generation, position, timeout.Token);
            if (!accepted) _actionError = action == MediaAction.ActivateSource
                ? "Não foi possível trazer o aplicativo da música para frente."
                : "O aplicativo não aceitou esse comando ou a mídia mudou.";
            await RefreshAsync(timeout.Token);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception error) when (error is COMException or UnauthorizedAccessException or InvalidOperationException or OperationCanceledException)
        { _actionError = "Não foi possível controlar o player agora. Tente novamente."; }
        finally { _busy = false; }
    }

    private void PreviewSeek(ChangeEventArgs args)
    {
        if (!_snapshot.CanSeek || !double.TryParse(args.Value?.ToString(), CultureInfo.InvariantCulture, out var value) || !double.IsFinite(value)) return;
        _seekGeneration ??= _snapshot.Generation;
        _seekPreview = Math.Clamp(value, 0, _snapshot.Duration);
    }

    private Task ActivateSourceAsync(MouseEventArgs args) => args.CtrlKey && args.Button == 0 && _snapshot.HasMedia
        ? CommandAsync(MediaAction.ActivateSource) : Task.CompletedTask;
    private Task HandleSongKeyAsync(KeyboardEventArgs args) => args.CtrlKey && args.Key == "Enter" && _snapshot.HasMedia
        ? CommandAsync(MediaAction.ActivateSource) : Task.CompletedTask;

    private async Task CommitSeekAsync(ChangeEventArgs args)
    {
        PreviewSeek(args);
        if (_seekPreview is { } value) await CommandAsync(MediaAction.Seek, value, _seekGeneration);
        _seekPreview = null;
        _seekGeneration = null;
    }

    private void ToggleVisualizer()
    {
        _showVisualizer = !_showVisualizer;

        _visualizerFailed = false;
        _visualizerError = null;
        if (!_showVisualizer) _spectrumCts?.Cancel();
    }

    private void SaveAppearance(Func<HoldItTogether.Services.Settings.HitSettings, HoldItTogether.Services.Settings.HitSettings> change)
    {
        _appearanceError = null;
        try { Settings.Update(change); _artworkMode = Settings.Current.AudioArtworkMode; }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException or InvalidOperationException or System.ComponentModel.Win32Exception)
        { _appearanceError = "Não foi possível salvar a aparência."; }
    }

    private void ToggleArtwork() => SaveAppearance(value => value with { AudioArtworkMode = !value.AudioArtworkMode });
    private void PreviewArtworkBlur(int value) => _blurPreview = value;
    private void SaveArtworkBlur(int value) { _blurPreview = null; SaveAppearance(settings => settings with { AudioArtworkBlur = value }); }
    private void SetGlobalArtworkAccent(bool enabled) => SaveAppearance(value => value with { AudioArtworkGlobalAccent = enabled });
    private void SetGlobalArtworkCover(bool enabled) => SaveAppearance(value => value with { AudioArtworkGlobalCover = enabled });
    private void SetLyricsArtworkCover(bool enabled) => SaveAppearance(value => value with { AudioArtworkLyricsCover = enabled });
    private void SetAudioSize((int X, int Y) size) => SaveAppearance(value => value with { AudioScaleX = size.X, AudioScaleY = size.Y });
    private void SetHideControls(bool enabled) => SaveAppearance(value => value with { AudioHideControls = enabled });
    private void SetShowSource(bool enabled) => SaveAppearance(value => value with { AudioShowSource = enabled });
    public bool IsSettingsOpen => _showSettings || _showAppearance;
    public Task CloseSettingsAsync() => InvokeAsync(async () => { await ReturnToPlayerAsync(); StateHasChanged(); });
    public Task OpenSettingsAsync() => InvokeAsync(() =>
    {
        _showSettings = true;
        _showLyrics = _showAppearance = false;
        _appearanceError = null;
        StateHasChanged();
    });
    private void OpenAppearance() { _showAppearance = true; _showLyrics = false; }
    private void HandleArtworkPointerUp(PointerEventArgs args) { if (args.Button == 2) OpenAppearance(); }

    private void ToggleLyrics()
    {
        if (_lyrics is null) return;
        _showLyrics = true;
        _showAppearance = false;
    }

    private Task ReturnToPlayerAsync()
    {
        _showLyrics = false;
        _showAppearance = false;
        _showSettings = false;
        return Task.CompletedTask;
    }

    private Task SeekLyricAsync(LyricSeekRequest request) => _snapshot.CanSeek
        ? CommandAsync(MediaAction.Seek, request.Position, request.Generation) : Task.CompletedTask;
    private bool BeginLyricsLookup(MediaSnapshot snapshot)
    {
        var key = snapshot.HasMedia ? snapshot.Title + "\n" + snapshot.Artist + "\n" + Math.Round(snapshot.Duration) : "";
        if (_lyricsKey == key && (_lyricsTask is { IsCompleted: false } || _lyrics is not null)) return false;
        if (_lyricsKey == key && !_lyricsLoading && DateTimeOffset.UtcNow - _lastLyricsLookup < TimeSpan.FromMinutes(2)) return false;
        _lyricsCts?.Cancel();
        _lyricsKey = key;
        _lyrics = null;
        if (key.Length == 0) { _lyricsLoading = false; return true; }
        _lyricsLoading = true;
        _lastLyricsLookup = DateTimeOffset.UtcNow;
        var source = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        _lyricsCts = source;
        _lyricsTask = LookupLyricsAsync(snapshot, key, source);
        return true;
    }

    private async Task LookupLyricsAsync(MediaSnapshot snapshot, string key, CancellationTokenSource source)
    {
        await Task.Yield();
        try
        {
            var lyrics = await Lyrics.FindAsync(snapshot, source.Token);
            await InvokeAsync(() =>
            {
                if (!_disposed && !source.IsCancellationRequested && _lyricsKey == key) _lyrics = lyrics;
            });
        }
        catch (OperationCanceledException) { }
        finally
        {
            if (ReferenceEquals(_lyricsCts, source))
            {
                _lyricsCts = null;
                _lyricsTask = null;
                _lyricsLoading = false;
                if (source.IsCancellationRequested && !_disposed) _lyricsKey = null;
            }
            source.Dispose();
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
    }

    private async Task VisualizeAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(50));
        var levels = new double[AudioSpectrumAnalyzer.BandCount];
        try
        {
            await Task.Run(Spectrum.Start, token);
            var outputCheck = 0;
            var recoveredFromError = false;
            do
            {
                token.ThrowIfCancellationRequested();
                if (++outputCheck >= 40 || (Spectrum.Error is not null && !recoveredFromError))
                {
                    if (Spectrum.Error is not null) recoveredFromError = true;
                    outputCheck = 0;
                    await Task.Run(Spectrum.RefreshOutput, token);
                }
                if (Spectrum.Error is { } error) throw new InvalidOperationException(error);
                if (_module is not null)
                {
                    Spectrum.CopyTo(levels);
                    await _module.InvokeVoidAsync("renderSpectrum", token, _spectrumElement, levels);
                }
            } while (await timer.WaitForNextTickAsync(token));
        }
        catch (OperationCanceledException) { }
        catch (JSDisconnectedException) { }
        catch (Exception error) when (error is COMException or InvalidOperationException or System.ComponentModel.Win32Exception)
        {
            _visualizerFailed = true;
            _visualizerError = "A saída de áudio não está disponível. Reabra o visualizador para tentar novamente.";
        }
        finally
        {
            try { await Task.Run(Spectrum.Stop); }
            catch (Exception error) when (error is COMException or InvalidOperationException)
            { _visualizerFailed = true; _visualizerError = "A saída de áudio foi desconectada."; }
            _spectrumCts?.Dispose();
            _spectrumCts = null;
            _spectrumTask = null;
            if (!_disposed) await InvokeAsync(StateHasChanged);
        }
    }

    private Task HandleKey(KeyboardEventArgs args) => args.Key == "Escape"
        ? (_showLyrics || _showAppearance || _showSettings ? ReturnToPlayerAsync() : MenuContext?.CloseRequested.InvokeAsync() ?? Task.CompletedTask) : Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Settings.Changed -= OnSettingsChanged;
        _lifetime.Cancel();
        _lyricsCts?.Cancel();
        _monitorCts?.Cancel();
        _spectrumCts?.Cancel();
        if (_monitorTask is { } monitor) await monitor;
        if (_spectrumTask is { } spectrum) await spectrum;
        if (_lyricsTask is { } lookup) await lookup;
        _lifetime.Dispose();
        try
        {
            if (_moduleLoad is not null) _module = await _moduleLoad;
            if (_module is not null) { await _module.InvokeVoidAsync("clearScene", _root); await _module.DisposeAsync(); }
        }
        catch (JSDisconnectedException) { }
    }
}
