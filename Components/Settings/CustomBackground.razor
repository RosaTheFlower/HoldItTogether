@using HoldItTogether.Services.Settings
@using HoldItTogether.Services.Themes
@using HoldItTogether.Services.Diagnostics
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject HitAppearanceService Appearance
@inject HitSettingsService Settings
@inject HitResourcePolicy Resources
@inject IJSRuntime JS

<div @ref="_root" class="sphere-custom-backdrop @(_current is not null ? "has-background-slides" : "")" data-hit-background-active="@(_playbackActive?"true":"false")" aria-hidden="true">
    @if (_current is not null)
    {
        @if (_previous is not null && _preferences.BackgroundMode == "smooth")
        {
            <BackgroundMediaFrame @key="_previous" Id="@_previous" CssClass="custom-background-exit" Style="@FrameStyle(_previous)" Fit="@_preferences.ImageFit" />
        }
        <BackgroundMediaFrame @key="_current" Id="@_current" CssClass="@("custom-background-enter "+(_preferences.BackgroundMode=="smooth"&&!Settings.Current.RemoveAnimations?_preferences.BackgroundTransition:"cut"))" Style="@FrameStyle(_current)" Fit="@_preferences.ImageFit" />
    }
</div>

@code {
    [Parameter] public bool Active { get; set; }
    [Parameter] public bool Inactive { get; set; }
    private HitAppearancePreferences _preferences = new();
    private HitAppearancePreferences? _source;
    private string? _current, _previous;
    private int _index, _frame;
    private bool _active, _inactive, _playbackActive, _presentationSuspended, _disposed;
    private long _generation;
    private CancellationTokenSource? _cycle;
    private Task? _worker, _refresh;
    private ElementReference _root;
    private IJSObjectReference? _module;
    private DotNetObjectReference<CustomBackground>? _reference;
    protected override void OnInitialized()
    {
        Appearance.Changed += Changed; Settings.Changed += Changed; Resources.Changed += Changed;
    }
    protected override async Task OnParametersSetAsync()
    {
        if (_active != Active || _inactive != Inactive || !ReferenceEquals(_source, Appearance.Current)) await (_refresh=RefreshAsync());
    }
    [JSInvokable] public Task SetPresentationSuspended(bool suspended)=>InvokeAsync(async()=>
    {
        if(_disposed||_presentationSuspended==suspended)return;
        _presentationSuspended=suspended;await (_refresh=RefreshAsync());
    });
    private void Changed() { if (!_disposed) _refresh = InvokeAsync(RefreshAsync); }
    private async Task RefreshAsync()
    {
        var generation = ++_generation;
        _cycle?.Cancel();
        if (_worker is not null) await _worker;
        if (_disposed || generation != _generation) return;
        _cycle?.Dispose(); _cycle = new();
        _active = Active; _inactive = Inactive; _source = Appearance.Current; _preferences = _source.Normalize();
        var state=_preferences.SphereState(_inactive);
        var visible=_active||state.ShowBackground is not false;
        var opacity=_active?_preferences.ImageOpacity:state.BackgroundOpacity??_preferences.ImageOpacity;
        _playbackActive=_preferences.Enabled&&visible&&opacity>0&&(_active||state.PlayBackground is true)&&!Resources.IsSleeping&&!Settings.Current.RemoveAnimations&&!_presentationSuspended;
        var images = _preferences.MediaIds.Where(id=>Appearance.MediaUrl(id)is not null).ToArray();
        _index = Math.Max(0, Array.IndexOf(images, _current));
        if(_preferences.BackgroundMode=="single")_index=0;
        var selected=images.ElementAtOrDefault(_index);
        var current = _preferences.Enabled && (_preferences.BackgroundMode != "single" || HitAppearanceService.IsVideo(selected)) ? selected : null;
        if (_current != current) _frame++;
        _current = current; _previous = null;
        if (_playbackActive && _current is not null && images.Length > 1 && _preferences.BackgroundMode!="single")
            _worker = CycleAsync(images, _cycle.Token);
        StateHasChanged();
    }
    private async Task CycleAsync(string[] images, CancellationToken token)
    {
        try
        {
            var interval=_preferences.BackgroundIntervalSeconds*1000;
            var transition=_preferences.BackgroundMode=="smooth"&&!Settings.Current.RemoveAnimations?_preferences.BackgroundTransitionMs:0;
            await Task.Delay(interval,token);
            while (true)
            {
                await InvokeAsync(() =>
                {
                    if (_disposed || token.IsCancellationRequested) return;
                    _previous = transition>0?_current:null; _index = (_index + 1) % images.Length; _current = images[_index]; _frame++;
                    StateHasChanged();
                });
                if(transition>0){await Task.Delay(transition,token);await InvokeAsync(()=>{_previous=null;StateHasChanged();});}
                await Task.Delay(Math.Max(1,interval-transition),token);
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }
    private string FrameStyle(string id) => $"background-image:url('{Appearance.PosterUrl(id)}');background-size:{(_preferences.ImageFit == "stretch" ? "100% 100%" : _preferences.ImageFit)};--background-transition:{(Settings.Current.RemoveAnimations ? 0 : _preferences.BackgroundTransitionMs)}ms";
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(!firstRender)return;
        var module=await JS.InvokeAsync<IJSObjectReference>("import","./js/hit-background-video.js");
        if(_disposed){await module.DisposeAsync();return;}_module=module;
        _reference=DotNetObjectReference.Create(this);await module.InvokeVoidAsync("connect",_root,_reference);
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true; _generation++;
        Appearance.Changed -= Changed; Settings.Changed -= Changed; Resources.Changed -= Changed;
        _cycle?.Cancel(); if (_worker is not null) await _worker; if (_refresh is not null) await _refresh; _cycle?.Dispose();
        if(_module is not null)try{await _module.InvokeVoidAsync("disconnect",_root);await _module.DisposeAsync();}catch(JSDisconnectedException){}
        _reference?.Dispose();
    }
}
