@using HoldItTogether.Services
@using HoldItTogether.Services.Diagnostics
@using HoldItTogether.Services.Extensions
@using HoldItTogether.Services.Themes
@using HoldItTogether.Services.Settings
@using HoldItTogether.Services.HitMenus
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject HitMemorySampler Memory
@inject HitUpdateService Updates
@inject ExtensionStore Extensions
@inject HitThemeService Themes
@inject HitDataService Data
@inject HitApplicationService Application
@inject IExternalLinkService Links
@inject IJSRuntime JS

<section class="info-view" data-hit-view="@(_showData ? "data" : "info")" data-no-drag @onwheel:stopPropagation="true">
    <button type="button" class="hit-back" @onclick="Back"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m11 5-5 5 5 5M6 10h10" /></svg>Settings</button>
    @if (_showData)
    {
        <h2 class="info-heading">Manage your data</h2>
        <p class="hit-muted">Choose what to remove. HIT restarts after you confirm.</p>
        <button type="button" class="hit-link-row" @onclick="() => _pending = false"><span>Reset all settings<small class="hit-muted">Keep installed themes and extensions. Clear saved preferences and module data.</small></span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m8 5 5 5-5 5" /></svg></button>
        <button type="button" class="hit-link-row" @onclick="() => _pending = true"><span>Delete everything<small class="hit-muted">Remove personal themes, extensions and all saved data.</small></span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m8 5 5 5-5 5" /></svg></button>
    }
    else
    {
        <div class="hit-setting-row"><span>RAM usage</span><output>@_memory</output></div>
        <div class="hit-setting-row"><span>HIT version</span><output>@HitUpdateService.VersionLabel</output></div>
        <div class="hit-setting-row"><span>Installed extensions</span><output>@Extensions.State.Packages.Count(item => !item.PendingDelete)</output></div>
        <div class="hit-setting-row"><span>Installed themes</span><output>@Themes.GetThemes().Count</output></div>
        <button type="button" class="hit-button info-wide" disabled="@_checking" @onclick="CheckUpdates">@(_checking ? "Checking…" : "Check for updates")</button>
        @if (_update is { } update)
        {
            <p class="hit-muted" role="status">@update.Message</p>
            @if (update.Url is not null) { <button type="button" class="hit-button info-wide" @onclick="() => OpenLink(update.Url)">Open release</button> }
        }
        <button type="button" class="hit-button info-wide info-github" @onclick="() => OpenLink(HitUpdateService.RepositoryUrl)" aria-label="Hold It Together on GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .8a11.2 11.2 0 0 0-3.54 21.83c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.03-.71.08-.7.08-.7 1.14.08 1.74 1.17 1.74 1.17 1.01 1.73 2.65 1.23 3.3.94.1-.73.4-1.23.72-1.52-2.5-.28-5.13-1.25-5.13-5.57 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.08 1.15a10.7 10.7 0 0 1 5.6 0c2.13-1.45 3.07-1.15 3.07-1.15.61 1.55.23 2.7.12 2.98.72.79 1.15 1.79 1.15 3.02 0 4.33-2.63 5.28-5.14 5.56.4.35.77 1.03.77 2.08v3.12c0 .3.2.65.77.54A11.2 11.2 0 0 0 12 .8Z" /></svg><span>Hold It Together</span></button>
        <button type="button" class="hit-button is-danger info-wide" @onclick="() => _showData = true">Delete my data</button>
    }
    @if (_error is not null) { <p class="settings-error" role="alert">@_error</p> }
    <dialog @ref="_dialog" class="hit-confirm theme-delete-dialog" @oncancel="Cancel" aria-labelledby="data-confirm-title" @onwheel:stopPropagation="true" @onkeydown:stopPropagation="true" @oncontextmenu="Cancel" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
        <h2 id="data-confirm-title">@(_pending == true ? "Delete everything?" : "Reset all settings?")</h2>
        <p>@(_pending == true ? "Personal themes, installed extensions and saved data will be permanently deleted." : "All preferences and module data will return to defaults. Installed themes and extensions will stay.")</p>
        <div class="dialog-actions"><button type="button" data-dialog-cancel @onclick="Cancel">Cancel</button><button type="button" class="is-primary" @onclick="Confirm">@(_pending == true ? "Delete everything" : "Reset settings")</button></div>
    </dialog>
</section>
@code {
    [Parameter] public EventCallback BackRequested { get; set; }
    [CascadingParameter(Name = "HitMenu")] public HitMenuContext? MenuContext { get; set; }
    private readonly CancellationTokenSource _lifetime = new();
    private Task? _monitor;
    private IJSObjectReference? _module;
    private ElementReference _dialog;
    private string _memory = "—";
    private string? _error;
    private bool _showData, _checking, _disposed, _dialogOpen;
    private bool? _pending;
    private HitUpdateResult? _update;
    protected override void OnInitialized() => _monitor = MonitorAsync(_lifetime.Token);
    private async Task MonitorAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            do
            {
                if (MenuContext?.IsVisible ?? true)
                {
                    var sample = Memory.Sample();
                    await InvokeAsync(() => { if (!_disposed) { _memory = sample.Bytes > 0 ? sample.Megabytes.ToString("N1", Text.Culture) + " MB" : "—"; StateHasChanged(); } });
                }
            } while (await timer.WaitForNextTickAsync(token));
        }
        catch (OperationCanceledException) { }
    }
    private Task Back() { if (_showData) { _showData = false; return Task.CompletedTask; } return BackRequested.InvokeAsync(); }
    private void Cancel() => _pending = null;
    private void OpenLink(string url) { if (!Links.OpenWebPage(url)) _error = "Could not open this link."; }
    private async Task CheckUpdates()
    {
        if (_checking) return; _checking = true; _error = null;
        try { _update = await Updates.CheckAsync(_lifetime.Token); }
        catch (OperationCanceledException) { if (!_disposed) _error = "The update check timed out."; }
        catch (Exception error) when (error is HttpRequestException or IOException or System.Text.Json.JsonException) { _error = "Could not check for updates. Please try again."; }
        finally { _checking = false; }
    }
    private async Task Confirm()
    {
        if (_pending is not { } all) return;
        _pending = null;
        try { Data.Request(all); await Application.RestartAsync(); }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException or InvalidOperationException or System.ComponentModel.Win32Exception) { Data.CancelRequest(); _error = "Could not restart HIT. Your data has been kept."; }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_dialogOpen == _pending.HasValue) return;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/hit-themes.js");
        await _module.InvokeVoidAsync("setDeleteDialog", _dialog, _pending.HasValue); _dialogOpen = _pending.HasValue;
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true; _lifetime.Cancel(); if (_monitor is not null) await _monitor; _lifetime.Dispose();
        if (_module is not null) try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
