@using HoldItTogether.Services
@using HoldItTogether.Services.Diagnostics
@using HoldItTogether.Services.Extensions
@using HoldItTogether.Services.Themes
@using HoldItTogether.Services.Settings
@using HoldItTogether.Services.HitMenus
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject HitUpdateService Updates
@inject ExtensionStore Extensions
@inject HitThemeService Themes
@inject HitDataService Data
@inject HitApplicationService Application
@inject IExternalLinkService Links
@inject IJSRuntime JS

<section class="info-view" data-hit-view="@_page.ToString().ToLowerInvariant()" data-no-drag>
    @if (IsDetailOpen && ShowBack)
    {
        <button type="button" class="hit-button" aria-label="@Text.Get("Back to Info")" @onclick="Back">@Text.Get("Info")</button>
    }
    else if (ShowBack)
    {
        <button type="button" class="hit-back" @onclick="Back"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m11 5-5 5 5 5M6 10h10" /></svg>@Text.Get("Settings")</button>
    }
    @if (_page == InfoPage.Changelog)
    {
        <ReleaseChangelogView />
    }
    else if (_page == InfoPage.Performance)
    {
        <HitPerformanceView />
    }
    else if (_page == InfoPage.Data)
    {
        <h2 class="info-heading">@Text.Get("Manage your data")</h2>
        <p class="hit-muted">@Text.Get("Choose what to remove. HIT restarts after you confirm.")</p>
        <button type="button" class="hit-link-row" @onclick="() => _pending = false"><span>@Text.Get("Reset all settings")<small class="hit-muted">@Text.Get("Keep installed themes and extensions. Clear saved preferences and module data.")</small></span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m8 5 5 5-5 5" /></svg></button>
        <button type="button" class="hit-link-row" @onclick="() => _pending = true"><span>@Text.Get("Delete everything")<small class="hit-muted">@Text.Get("Remove personal themes, extensions and all saved data.")</small></span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m8 5 5 5-5 5" /></svg></button>
    }
    else
    {
        <h2>@Text.Get("Info")</h2>
        <div class="hit-setting-row"><span>@Text.Get("HIT version")</span><output>@HitUpdateService.VersionLabel</output></div>
        <div class="hit-setting-row"><span>@Text.Get("Installed extensions")</span><output>@Extensions.State.Packages.Count(item => !item.PendingDelete)</output></div>
        <div class="hit-setting-row"><span>@Text.Get("Installed themes")</span><output>@Themes.GetThemes().Count</output></div>
        <button type="button" class="hit-link-row" aria-label="@Text.Get("Open Performance")" title="@Text.Get("View memory, CPU and local diagnostics.")" @onclick="OpenPerformanceAsync"><span>@Text.Get("Performance")</span><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m8 5 5 5-5 5" /></svg></button>
        <div class="info-footer">
        <div class="info-actions">
            @if (_update is not null || _updateError is not null)
            {
                <div class="info-update-feedback hit-muted" role="status">

                    <p class="hit-muted">@(_updateError ?? _update?.Message)</p>
                    @if (_update?.Url is { } url) { <button type="button" class="hit-button" @onclick="() => OpenLink(url)">@Text.Get("Open release")</button> }
                </div>
            }
            <div class="info-action-row">
                <button type="button" class="hit-button info-wide" aria-label="@Text.Get("Changelog")" @onclick="() => _page = InfoPage.Changelog">@Text.Get("Changelog")</button>
                <button type="button" class="hit-button info-wide" aria-label="@Text.Get("Check for updates")" aria-busy="@(_checking ? "true" : "false")" disabled="@_checking" @onclick="CheckUpdates">
                    @if (_checking) { <HitSpinner Label="@Text.Get("Checking for updates")" /> }
                    else { @Text.Get("Check for updates") }
                </button>
                <button type="button" class="hit-button info-wide info-github" @onclick="() => OpenLink(HitUpdateService.RepositoryUrl)" aria-label="@Text.Get("Hold It Together on GitHub")"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .8a11.2 11.2 0 0 0-3.54 21.83c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.03-.71.08-.7.08-.7 1.14.08 1.74 1.17 1.74 1.17 1.01 1.73 2.65 1.23 3.3.94.1-.73.4-1.23.72-1.52-2.5-.28-5.13-1.25-5.13-5.57 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.08 1.15a10.7 10.7 0 0 1 5.6 0c2.13-1.45 3.07-1.15 3.07-1.15.61 1.55.23 2.7.12 2.98.72.79 1.15 1.79 1.15 3.02 0 4.33-2.63 5.28-5.14 5.56.4.35.77 1.03.77 2.08v3.12c0 .3.2.65.77.54A11.2 11.2 0 0 0 12 .8Z" /></svg><span>Hold It Together</span></button>
            </div>
        </div>
        <button type="button" class="hit-button is-danger info-wide" @onclick="OpenDataAsync">@Text.Get("Delete my data")</button>
        </div>
    }
    @if (_error is not null) { <p class="settings-error" role="alert">@_error</p> }
    <dialog @ref="_dialog" class="hit-confirm theme-delete-dialog" @oncancel="Cancel" aria-labelledby="data-confirm-title" @onwheel:stopPropagation="true" @onkeydown:stopPropagation="true" @oncontextmenu="Cancel" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
        <h2 id="data-confirm-title">@Text.Get(_pending == true ? "Delete everything?" : "Reset all settings?")</h2>
        <p>@Text.Get(_pending == true ? "Personal themes, installed extensions and saved data will be permanently deleted." : "All preferences and module data will return to defaults. Installed themes and extensions will stay.")</p>
        <div class="dialog-actions"><button type="button" data-dialog-cancel @onclick="Cancel">@Text.Get("Cancel")</button><button type="button" class="is-primary" @onclick="Confirm">@Text.Get(_pending == true ? "Delete everything" : "Reset settings")</button></div>
    </dialog>
</section>
@code {
    [Parameter] public EventCallback BackRequested { get; set; }
    [Parameter] public string Page { get; set; } = "Info";
    [Parameter] public EventCallback<string> PageChanged { get; set; }
    private string? _receivedPage;
    protected override void OnParametersSet() { if (_receivedPage != Page) { _receivedPage = Page; if (Enum.TryParse<InfoPage>(Page,out var parsed) && Enum.IsDefined(parsed)) _page = parsed; } }
    [Parameter] public bool ShowBack { get; set; } = true;
    [Parameter] public EventCallback NavigationChanged { get; set; }
    private enum InfoPage { Info, Changelog, Data, Performance }
    private InfoPage _page;
    private readonly CancellationTokenSource _lifetime = new();
    private IJSObjectReference? _module;
    private ElementReference _dialog;
    private string? _error, _updateError;
    private bool _checking, _disposed, _dialogOpen;
    private bool? _pending;
    private HitUpdateResult? _update;
    private Task? _checkTask;
    public bool IsDetailOpen => _page != InfoPage.Info;
    public string CurrentTitle => _page switch { InfoPage.Changelog => "Changelog", InfoPage.Data => "Manage your data", InfoPage.Performance => "Performance", _ => "Info" };
    private InfoPage? _publishedPage;
    public Task CloseDetailAsync() => InvokeAsync(async () => { await Back(); StateHasChanged(); });
    public Task OpenPerformanceAsync() => InvokeAsync(() => { _page = InfoPage.Performance; StateHasChanged(); });
    public Task OpenDataAsync() => InvokeAsync(() => { _page = InfoPage.Data; StateHasChanged(); });
    private Task Back()
    {
        if (IsDetailOpen) { _page = InfoPage.Info; return Task.CompletedTask; }
        return BackRequested.InvokeAsync();
    }
    private void Cancel() => _pending = null;
    private void DismissUpdate() { _update = null; _updateError = null; }
    private void OpenLink(string url) { if (!Links.OpenWebPage(url)) _error = Text.Get("Could not open this link."); }
    private Task CheckUpdates() => _checking || _disposed ? Task.CompletedTask : _checkTask = CheckUpdatesAsync();
    private async Task CheckUpdatesAsync()
    {
        if (_checking || _disposed) return;
        _checking = true; DismissUpdate();
        try { _update = await Updates.CheckAsync(_lifetime.Token); }
        catch (OperationCanceledException) { if (!_disposed) _updateError = Text.Get("The update check timed out."); }
        catch (Exception error) when (error is HttpRequestException or IOException or System.Text.Json.JsonException)
        { _updateError = Text.Get("Could not check for updates. Please try again."); }
        finally { _checking = false; }
    }
    private async Task Confirm()
    {
        if (_pending is not { } all) return;
        _pending = null;
        try { Data.Request(all); await Application.RestartAsync(); }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException or InvalidOperationException or System.ComponentModel.Win32Exception)
        { Data.CancelRequest(); _error = Text.Get("Could not restart HIT. Your data has been kept."); }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_publishedPage != _page) { _publishedPage = _page; await PageChanged.InvokeAsync(_page.ToString()); await NavigationChanged.InvokeAsync(); }
        if (_dialogOpen == _pending.HasValue) return;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/hit-themes.js");
        await _module.InvokeVoidAsync("setDeleteDialog", _dialog, _pending.HasValue); _dialogOpen = _pending.HasValue;
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true; _lifetime.Cancel();
        if (_checkTask is not null) await _checkTask;
        _lifetime.Dispose();
        if (_module is not null) try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
