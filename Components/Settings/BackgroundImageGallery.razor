@using HoldItTogether.Services.Themes
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject HitAppearanceService Appearance
@inject IJSRuntime JS

<section class="background-gallery" aria-label="@Text.Get("Background image preview")" data-no-drag @onkeydown="HandleKey" @onkeydown:stopPropagation="true" @onfocusout="()=>_armed=null" @onclick:stopPropagation="true">
    <div class="background-gallery-carousel">
        <button type="button" class="background-gallery-arrow" disabled="@(Disabled || Images.Length < 2)" aria-label="@Text.Get("Previous images")" @onclick="()=>MoveAsync(-1)">&#8249;</button>
        <div @ref="_track" class="background-gallery-track" tabindex="0" role="region" aria-label="@Text.Get("Selected background images")">
            @for (var i = 0; i < Images.Length; i++)
            {
                var id = Images[i]; var index = i + 1;
                <div @key="id" class="background-gallery-item">
                    <button type="button" class="background-gallery-select" aria-label="@Text.Format("Select background image {0}", index)" aria-pressed="@(_selected == id ? "true" : "false")" disabled="@Disabled" @onclick="()=>Select(id)">
                        @if (_urls.GetValueOrDefault(id) is { } url) { <img src="@url" alt="@Text.Format("Background image {0}", index)" loading="lazy" decoding="async" draggable="false" /> }
                        else { <span>@Text.Format("Image {0}", index)</span> }
                    </button>
                    @if (_selected == id)
                    {
                        <button type="button" class="background-gallery-delete @(_armed == id ? "is-armed" : "")" aria-label="@Text.Get(_armed == id ? "Confirm image removal" : "Remove selected image")" title="@Text.Get(_armed == id ? "Click again to remove this image" : "Click twice to remove this image")" disabled="@Disabled" @onclick="()=>DeleteAsync(id)">
                            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 6h12M8 3h4M6 6l1 11h6l1-11M9 9v5m2-5v5" /></svg>
                        </button>
                    }
                </div>
            }
            @if (Images.Length == 0) { <p class="hit-muted">@Text.Get("No background images selected.")</p> }
        </div>
        <button type="button" class="background-gallery-arrow" disabled="@(Disabled || Images.Length < 2)" aria-label="@Text.Get("Next images")" @onclick="()=>MoveAsync(1)">&#8250;</button>
    </div>
    @if (_armed is not null) { <p class="hit-muted" role="status">@Text.Get("Click the trash button again to remove this image. Escape cancels.")</p> }
    <dialog @ref="_dialog" class="theme-delete-dialog hit-confirm" aria-labelledby="@_titleId" @oncancel="CancelAll" @oncontextmenu="CancelAll" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true" @onwheel:stopPropagation="true" @onkeydown:stopPropagation="true">
        <h2 id="@_titleId">@Text.Get("Remove all background images?")</h2>
        <p>@Text.Format("Remove all {0} images from this background selection?", Images.Length)</p>
        <div class="dialog-actions"><button type="button" data-dialog-cancel aria-label="@Text.Get("Cancel removing all images")" @onclick="CancelAll">@Text.Get("Cancel")</button><button type="button" class="is-primary" aria-label="@Text.Get("Confirm removing all images")" @onclick="ConfirmAllAsync">@Text.Get("Remove all images")</button></div>
    </dialog>
</section>

@code {
    [Parameter] public string[] Images { get; set; } = [];
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<string> RemoveRequested { get; set; }
    [Parameter] public EventCallback RemoveAllRequested { get; set; }
    private readonly string _titleId = "remove-background-"+Guid.NewGuid().ToString("N");
    private readonly Dictionary<string,string?> _urls = [];
    private string? _selected, _armed, _imageKey;
    private ElementReference _track, _dialog;
    private IJSObjectReference? _module;
    private bool _confirmAll, _disposed;
    protected override void OnParametersSet()
    {
        var key=Appearance.GifBackgroundsAllowed+":"+string.Join(',',Images);
        if (_imageKey != key) { _imageKey=key; _urls.Clear(); foreach(var id in Images) _urls[id]=Appearance.ImageUrl(id); _armed=null; }
        if (_selected is not null && !Images.Contains(_selected)) _selected=null;
        if (Images.Length==0) _confirmAll=false;
    }
    private void Select(string id) { _selected = _selected==id?null:id; _armed=null; }
    private async Task DeleteAsync(string id)
    {
        if (Disabled || !Images.Contains(id)) return;
        if (_armed!=id) { _armed=id; return; }
        _armed=_selected=null; await RemoveRequested.InvokeAsync(id);
    }
    public Task AskRemoveAllAsync() => InvokeAsync(()=> { if (!Disabled && Images.Length>0) { _armed=null; _confirmAll=true; StateHasChanged(); } });
    private void CancelAll() => _confirmAll=false;
    private async Task ConfirmAllAsync() { if(!_confirmAll || Disabled)return; _confirmAll=false; _selected=_armed=null; await RemoveAllRequested.InvokeAsync(); }
    private void HandleKey(KeyboardEventArgs args) { if(args.Key=="Escape"){_selected=_armed=null;} }
    private async Task MoveAsync(int direction) { _selected=_armed=null; if(_module is not null) await _module.InvokeVoidAsync("move",_track,direction); }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            var module=await JS.InvokeAsync<IJSObjectReference>("import","./js/hit-image-gallery.js");
            if(_disposed){await module.DisposeAsync();return;}_module=module;
            await _module.InvokeVoidAsync("connect",_track);
        }
        if(_module is not null)await _module.InvokeVoidAsync("dialog",_dialog,_confirmAll);
    }
    public async ValueTask DisposeAsync()
    {
        _disposed=true;
        if(_module is null)return;
        try { await _module.InvokeVoidAsync("dialog",_dialog,false); await _module.InvokeVoidAsync("disconnect",_track); await _module.DisposeAsync(); } catch(JSDisconnectedException) { }
    }
}
