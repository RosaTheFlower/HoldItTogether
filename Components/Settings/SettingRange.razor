<div class="settings-number settings-option @CssClass">
    <label class="settings-slider-label" for="@_id" title="@Text.Get(Description)">@Text.Get(Label)</label>
    <div class="settings-number-controls">
        <input id="@_id" type="range" min="@N(Min)" max="@N(Max)" step="@N(Step)" value="@N(Value)" aria-label="@Text.Get(Label)" disabled="@Disabled" @oninput="Change" @onchange="Change" @onwheel:stopPropagation="true" />
        <input type="number" min="@N(Min)" max="@N(Max)" step="@N(Step)" value="@N(Value)" aria-label="@($"{Text.Get(Label)} value")" disabled="@Disabled" @onchange="Change" /><span>@Unit</span>
    </div>
</div>
@code {
    [Parameter] public string Label {get;set;}="";
    [Parameter] public string? CssClass {get;set;}
    [Parameter] public string Description {get;set;}="";
    [Parameter] public string Unit {get;set;}="";
    [Parameter] public double Value {get;set;}
    [Parameter] public double Min {get;set;}
    [Parameter] public double Max {get;set;}=100;
    [Parameter] public double Step {get;set;}=1;
    [Parameter] public bool Disabled {get;set;}
    [Parameter] public EventCallback<double> Changed {get;set;}
    private readonly string _id="setting-"+Guid.NewGuid().ToString("N");
    private static string N(double value)=>value.ToString(System.Globalization.CultureInfo.InvariantCulture);
    private Task Change(ChangeEventArgs e)=>double.TryParse(e.Value?.ToString(),System.Globalization.CultureInfo.InvariantCulture,out var number)&&double.IsFinite(number)
        ?Changed.InvokeAsync(Math.Clamp(number,Min,Max)):Task.CompletedTask;
}
