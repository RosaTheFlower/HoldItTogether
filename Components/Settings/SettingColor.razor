@using HoldItTogether.Services.Themes
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="hit-setting-row hit-color-setting" data-no-drag>
    <span>@Text.Get(Label)</span>
    <button @ref="_button" type="button" class="hit-color-swatch" aria-label="@Text.Format("Edit {0} color",Text.Get(Label))" aria-haspopup="dialog" aria-expanded="@(_open ? "true" : "false")" @onclick="Open"><span style="@($"background:{Value}")"></span></button>
    <dialog @ref="_dialog" class="theme-delete-dialog hit-confirm hit-color-dialog" style="@($"--picker-color:{(_color with{Alpha=255}).Hex}")" aria-label="@Text.Format("Edit {0} color",Text.Get(Label))" @oncancel:preventDefault="true" @oncancel="Close" @onkeydown:stopPropagation="true" @oncontextmenu:stopPropagation="true" @onwheel:stopPropagation="true">
        <div class="hit-color-heading"><h2>@Text.Get(Label)</h2><button type="button" class="hit-button hit-color-done" @onclick="Close">@Text.Get("Done")</button></div>
        <div class="hit-color-sv" tabindex="0" role="group" aria-label="@Text.Get("Saturation and brightness")" style="@($"--picker-hue:{N(_hue)};--picker-s:{N(_saturation)}%;--picker-v:{N(100-_brightness)}%")" @onkeydown="MoveKey"><span></span></div>
        <SettingRange CssClass="hit-color-hue" Label="Hue" Description="Choose the color hue." Value="Math.Round(_hue)" Min="0" Max="359" Unit="°" Changed="HueChanged" />
        <SettingRange CssClass="hit-color-alpha" Label="Alpha" Description="0% is transparent; 100% is opaque." Value="Math.Round(_color.Alpha/255d*100)" Min="0" Max="100" Unit="%" Changed="AlphaChanged" />
        <div class="hit-color-channels">
            @foreach(var channel in new[]{"R","G","B","A"})
            {
                <label>@channel<input type="number" min="0" max="255" step="1" aria-label="@Text.Format("{0} color channel",channel)" value="@Channel(channel)" @oninput="e=>ChannelChanged(channel,e)" /></label>
            }
        </div>
        <label class="hit-setting-row hit-color-hex"><span>@Text.Get("HEX")</span><input type="text" aria-label="@Text.Get("HEX color")" value="@_hex" maxlength="9" spellcheck="false" aria-invalid="@(_invalid?"true":"false")" @oninput="HexChanged" /></label>
    </dialog>
</div>

@code {
    [Parameter] public string Label { get; set; } = "Color";
    [Parameter] public string Value { get; set; } = "#000000";
    [Parameter] public EventCallback<string> Changed { get; set; }
    private ElementReference _dialog,_button;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SettingColor>? _reference;
    private HitColor _color;
    private string _hex="",_source="";
    private double _hue,_saturation,_brightness;
    private bool _open,_invalid,_disposed;
    private static string N(double value)=>value.ToString(System.Globalization.CultureInfo.InvariantCulture);
    protected override void OnParametersSet()
    {
        if(_source==Value)return;
        _source=Value;
        if(HitColor.TryParse(Value,out var color)){_color=color;_hex=color.Hex;(_hue,_saturation,_brightness)=color.Hsv();_invalid=false;}
    }
    private void Open(){_hex=_color.Hex;_invalid=false;_open=true;}
    [JSInvokable] public Task Close()=>InvokeAsync(()=>{_open=false;StateHasChanged();});
    private async Task Publish(HitColor color)
    {
        _color=color;_hex=color.Hex;_source=color.Hex;_invalid=false;
        await Changed.InvokeAsync(color.Hex);
    }
    private async Task HexChanged(ChangeEventArgs args)
    {
        _hex=args.Value?.ToString()??"";_invalid=!HitColor.TryParse(_hex,out var color);
        if(_invalid)return;
        (_hue,_saturation,_brightness)=color.Hsv();await Publish(color);
    }
    private Task HueChanged(double value)=>HsvChanged(value,_saturation,_brightness);
    private Task AlphaChanged(double value)=>Publish(_color with{Alpha=(byte)Math.Round(value/100*255)});
    private Task HsvChanged(double h,double s,double v){_hue=h;_saturation=s;_brightness=v;return Publish(HitColor.FromHsv(h,s,v,_color.Alpha));}
    [JSInvokable] public Task SetSaturationBrightness(double s,double v)=>InvokeAsync(async()=>{if(!_open||_disposed)return;await HsvChanged(_hue,Math.Clamp(s,0,100),Math.Clamp(v,0,100));StateHasChanged();});
    private int Channel(string key)=>key switch{"R"=>_color.Red,"G"=>_color.Green,"B"=>_color.Blue,_=>_color.Alpha};
    private async Task ChannelChanged(string key,ChangeEventArgs args)
    {
        if(!byte.TryParse(args.Value?.ToString(),out var value))return;
        var color=key switch{"R"=>_color with{Red=value},"G"=>_color with{Green=value},"B"=>_color with{Blue=value},_=>_color with{Alpha=value}};
        (_hue,_saturation,_brightness)=color.Hsv();await Publish(color);
    }
    private Task MoveKey(KeyboardEventArgs args)
    {
        var step=args.ShiftKey?10:1;
        return args.Key switch{
            "ArrowLeft"=>HsvChanged(_hue,Math.Max(0,_saturation-step),_brightness),
            "ArrowRight"=>HsvChanged(_hue,Math.Min(100,_saturation+step),_brightness),
            "ArrowUp"=>HsvChanged(_hue,_saturation,Math.Min(100,_brightness+step)),
            "ArrowDown"=>HsvChanged(_hue,_saturation,Math.Max(0,_brightness-step)),_=>Task.CompletedTask};
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender){var module=await JS.InvokeAsync<IJSObjectReference>("import","./js/hit-color-picker.js");if(_disposed){await module.DisposeAsync();return;}_module=module;_reference=DotNetObjectReference.Create(this);}
        if(_module is not null)await _module.InvokeVoidAsync("connect",_dialog,_button,_open,_reference);
    }
    public async ValueTask DisposeAsync()
    {
        _disposed=true;
        if(_module is not null)try{await _module.InvokeVoidAsync("disconnect",_dialog);await _module.DisposeAsync();}catch(JSDisconnectedException){}
        _reference?.Dispose();
    }
}
