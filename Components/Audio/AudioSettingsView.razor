@using HoldItTogether.Services.Settings
@using HoldItTogether.Components.Settings
<section class="audio-settings-view" aria-label="@Text.Get("Audio settings")" data-no-drag>
@if (Topic == "Size")
{
    <SettingRange Label="Uniform audio size" Description="Scale the player and lyrics equally on both axes." Value="@((int)Math.Round((Settings.AudioScaleX + Settings.AudioScaleY) / 10d) * 5)" Min="25" Max="200" Step="5" Unit="%" Changed="v => SizeChanged.InvokeAsync(((int)v, (int)v))" />
    <SettingRange Label="Audio width" Description="Set the horizontal scale of the player and lyrics." Value="Settings.AudioScaleX" Min="25" Max="200" Step="5" Unit="%" Changed="v => SizeChanged.InvokeAsync(((int)v, Settings.AudioScaleY))" />
    <SettingRange Label="Audio height" Description="Set the vertical scale of the player and lyrics." Value="Settings.AudioScaleY" Min="25" Max="200" Step="5" Unit="%" Changed="v => SizeChanged.InvokeAsync((Settings.AudioScaleX, (int)v))" />
}
else if (Topic == "Lyrics")
{
    <SettingToggle Label="Show song title in lyrics" Description="Display the track name above the lyrics." Value="Settings.AudioLyricsShowTitle" Changed="LyricsTitleChanged" />
    <SettingToggle Label="Show lyrics source" Description="Display the lyrics provider and its source link." Value="Settings.AudioLyricsShowSource" Changed="LyricsSourceChanged" />
    <SettingToggle Label="Show timeline in lyrics" Description="Show the seekable playback timeline along the edge of the lyrics." Value="Settings.AudioLyricsTimeline" Changed="TimelineChanged" />
    <SettingRange Label="Lyrics timeline thickness" Description="Set the thickness of the lyrics playback timeline." Value="Settings.AudioLyricsTimelineThickness" Min="1" Max="6" Unit="px" Disabled="!Settings.AudioLyricsTimeline" Changed="v => TimelineThicknessChanged.InvokeAsync((int)v)" />
}
else
{
    <SettingToggle Label="Show audio source" Description="Display the application currently playing audio." Value="Settings.AudioShowSource" Changed="ShowSourceChanged" />
}
@if (Error is { } error) { <p class="audio-error" role="status">@error</p> }
</section>
@code {
    [Parameter] public string Topic { get; set; } = "General";
    [Parameter, EditorRequired] public HitSettings Settings { get; set; } = new();
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback<(int X, int Y)> SizeChanged { get; set; }
    [Parameter] public EventCallback<bool> ShowSourceChanged { get; set; }
    [Parameter] public EventCallback<bool> TimelineChanged { get; set; }
    [Parameter] public EventCallback<bool> LyricsTitleChanged { get; set; }
    [Parameter] public EventCallback<bool> LyricsSourceChanged { get; set; }
    [Parameter] public EventCallback<int> TimelineThicknessChanged { get; set; }
}
