@using HoldItTogether.Components.Settings
<SettingRange CssClass="audio-effect-row" Label="@Label" Description="@Text.Format("Adjust {0}.", Text.Get(Label))" Min="Min" Max="Max" Step="Step" Value="Value" Unit="@Unit.Trim()" Disabled="Disabled" Changed="v=>ValueChanged.InvokeAsync((int)v)" />
@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Unit { get; set; } = "";
    [Parameter] public int Min { get; set; }
    [Parameter] public int Max { get; set; } = 100;
    [Parameter] public int Step { get; set; } = 1;
    [Parameter] public int Value { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
}
