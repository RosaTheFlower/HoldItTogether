@using HoldItTogether.Services.Audio
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject HoldItTogether.Services.IExternalLinkService ExternalLinks

<section class="audio-lyrics-view" aria-label="Letras da música" @oncontextmenu="ReturnAsync" @oncontextmenu:preventDefault="true"
         @onpointerup="HandlePointerUp" data-no-drag>
    <div class="lyrics-heading">
        <div class="hit-idle-collapse" data-hit-collapse="lyrics"><div class="hit-idle-collapse-content">
        <button type="button" class="lyrics-back audio-view-back" aria-label="Voltar ao áudio" title="Voltar ao áudio (botão direito)" data-hit-idle-controls @onclick="ReturnAsync">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m11 5-5 5 5 5M6 10h10" /></svg>
            <span>Áudio</span>
        </button>
        </div></div>
        <button type="button" class="lyrics-provider" data-ctrl-link="@(HasSourceLink ? "true" : null)"
                disabled="@(!HasSourceLink)" title="@(HasSourceLink ? "Ctrl + clique para abrir a fonte da letra" : null)"
                aria-label="@($"Fonte da letra: {Lyrics?.Source}. Ctrl + clique para abrir")" @onclick="OpenSource">@(Lyrics?.Source ?? "")</button>
    </div>
    @if (_sourceError is { } sourceError) { <p class="audio-error" role="status">@sourceError</p> }
    @if (Lyrics is { } lyrics)
    {
        var current = lyrics.CurrentIndex(Position);
        <div @ref="_viewport" class="lyrics-viewport" tabindex="0" aria-label="Letra da música" @onwheel:stopPropagation="true">
            <div class="lyrics-lines">
                @for (var index = 0; index < lyrics.Lines.Count; index++)
                {
                    var lineIndex = index;
                    var generation = Generation;
                    var line = lyrics.Lines[index];
                    <button @key="index" type="button"
                            class="lyric-line @(index == current ? "is-current" : index < current ? "is-past" : "is-future")"
                            data-line-index="@index" style="@($"--lyric-distance:{Math.Min(4, Math.Abs(index - current))}")"
                            aria-current="@(index == current ? "true" : null)"
                            aria-label="@($"Ir para {FormatTime(line.Time)}: {line.Text}")"
                            title="@(CanSeek ? "Reproduzir a partir deste trecho" : "Este aplicativo não permite avançar pela letra")"
                            disabled="@(!CanSeek || Busy)" @onclick="() => SeekRequested.InvokeAsync(new LyricSeekRequest(generation, lyrics.Lines[lineIndex].Time))">
                        @(string.IsNullOrWhiteSpace(line.Text) ? "♪" : line.Text)
                    </button>
                }
            </div>
        </div>
    }
    else
    {
        <div class="lyrics-empty" role="status">@(Loading ? "Buscando letra sincronizada…" : "Letra sincronizada indisponível para esta faixa.")</div>
    }
</section>

@code {
    [Parameter] public SyncedLyrics? Lyrics { get; set; }
    [Parameter] public long Generation { get; set; }
    [Parameter] public double Position { get; set; }
    [Parameter] public bool CanSeek { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public EventCallback<LyricSeekRequest> SeekRequested { get; set; }
    [Parameter] public EventCallback BackRequested { get; set; }
    private ElementReference _viewport;
    private IJSObjectReference? _module;
    private SyncedLyrics? _lastLyrics;
    private int _lastIndex = int.MinValue;
    private bool _disposed;
    private string? _sourceError;
    private bool HasSourceLink => HoldItTogether.Services.ExternalLinkService.IsWebAddress(Lyrics?.SourceUrl);
    private void OpenSource(MouseEventArgs args)
    {
        if (!args.CtrlKey || args.Button != 0 || !HasSourceLink) return;
        _sourceError = ExternalLinks.OpenWebPage(Lyrics?.SourceUrl) ? null : "Não foi possível abrir a fonte da letra.";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (Lyrics is null)
        {
            if (_module is not null && _lastLyrics is not null) await _module.InvokeVoidAsync("disconnectLyrics", _viewport);
            _lastLyrics = null; _lastIndex = int.MinValue;
            return;
        }
        var index = Lyrics.CurrentIndex(Position);
        var changed = !ReferenceEquals(Lyrics, _lastLyrics);
        if (!changed && index == _lastIndex) return;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/audio-player.js");
        if (_disposed) return;
        _lastLyrics = Lyrics;
        _lastIndex = index;
        await _module.InvokeVoidAsync("followLyrics", _viewport, index, changed);
    }

    private static string FormatTime(double seconds)
    {
        var time = TimeSpan.FromSeconds(seconds);
        return time.TotalHours >= 1 ? $"{(int)time.TotalHours}:{time.Minutes:00}:{time.Seconds:00}" : $"{(int)time.TotalMinutes}:{time.Seconds:00}";
    }

    private Task ReturnAsync() => BackRequested.InvokeAsync();
    private Task HandlePointerUp(PointerEventArgs args) => args.Button == 2 ? ReturnAsync() : Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is null) return;
        try { await _module.InvokeVoidAsync("disconnectLyrics", _viewport); await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
