@using HoldItTogether.Services.Settings
<section class="audio-effects-view" aria-label="Background effects" data-no-drag @oncontextmenu:preventDefault="true">
    <div class="audio-effects-scroll" data-hit-scroll tabindex="0" aria-label="Background effects">
        <label class="hit-setting-row"><span>Blur style</span><select aria-label="Blur style" value="@(Settings.AudioArtworkRadialBlur ? "radial" : "gaussian")" @onchange="ChangeBlur"><option value="gaussian">Gaussian</option><option value="radial">Radial</option></select></label>
        <AudioEffectSlider Label="Background blur" Value="Settings.AudioArtworkBlur" Max="40" Unit=" px" ValueChanged="number => Change(value => value with {AudioArtworkBlur=number})" />
        <AudioEffectSlider Label="Zoom" Value="Settings.AudioArtworkZoom" Min="100" Max="180" Step="5" Unit="%" ValueChanged="number => Change(value => value with {AudioArtworkZoom=number})" />
        <AudioEffectSlider Label="Distortion" Unit="px" Value="Settings.AudioArtworkDistortion" Max="30" ValueChanged="number => Change(value => value with {AudioArtworkDistortion=number})" />
        <AudioEffectSlider Label="Lens" Value="Settings.AudioArtworkLens" Unit="%" ValueChanged="number => Change(value => value with {AudioArtworkLens=number})" />
        <AudioEffectSlider Label="Chromatic shift" Value="Settings.AudioArtworkChromatic" Max="20" Unit=" px" ValueChanged="number => Change(value => value with {AudioArtworkChromatic=number})" />
        <AudioEffectSlider Label="Vignette" Value="Settings.AudioArtworkVignette" Unit="%" ValueChanged="number => Change(value => value with {AudioArtworkVignette=number})" />
        <AudioEffectSlider Label="Grain" Value="Settings.AudioArtworkGrain" Max="30" Unit="%" ValueChanged="number => Change(value => value with {AudioArtworkGrain=number})" />
        <label class="hit-setting-row"><span>Slow drift</span><input type="checkbox" class="hit-switch" role="switch" aria-label="Slow background drift" checked="@Settings.AudioArtworkDrift" @onchange="args => Change(value => value with {AudioArtworkDrift=args.Value is true})" /></label>
        <label class="hit-setting-row"><span>OnBeat<small>Blend effects with the music's beats.</small></span><input type="checkbox" class="hit-switch" role="switch" aria-label="OnBeat" checked="@Settings.AudioArtworkOnBeat" @onchange="args => Change(value => value with {AudioArtworkOnBeat=args.Value is true})" /></label>
        <AudioEffectSlider Label="Beat strength" Value="Settings.AudioArtworkBeatStrength" Max="200" Step="5" Unit="%" Disabled="!Settings.AudioArtworkOnBeat" ValueChanged="number => Change(value => value with {AudioArtworkBeatStrength=number})" />
    </div>
    @if (Error is not null) { <p class="audio-error" role="alert">@Error</p> }
</section>
@code {
    [Parameter] public HitSettings Settings { get; set; } = new();
    [Parameter] public EventCallback<HitSettings> Changed { get; set; }


    [Parameter] public string? Error { get; set; }
    private Task Change(Func<HitSettings,HitSettings> update) => Changed.InvokeAsync(update(Settings).Normalize());
    private Task ChangeBlur(ChangeEventArgs args) => Change(value => value with { AudioArtworkRadialBlur = args.Value?.ToString() == "radial" });
}
