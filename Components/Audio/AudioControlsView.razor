@using HoldItTogether.Services.Settings
<section class="audio-controls-view" aria-label="Hide buttons" data-no-drag @oncontextmenu:preventDefault="true">
    <label class="hit-setting-row"><span>Player<small>Hide secondary buttons and compact the player.</small></span><input class="hit-switch" type="checkbox" role="switch" aria-label="Hide player buttons" @bind:get="Settings.AudioHidePlayerButtons" @bind:set="SetPlayer" /></label>
    <label class="hit-setting-row"><span>Lyrics<small>Hide secondary buttons for more reading space.</small></span><input class="hit-switch" type="checkbox" role="switch" aria-label="Hide lyrics buttons" @bind:get="Settings.AudioHideLyricsButtons" @bind:set="SetLyrics" /></label>
    @if (Error is not null) { <p class="audio-error" role="alert">@Error</p> }
</section>
@code {
    [Parameter] public HitSettings Settings { get; set; } = new();
    [Parameter] public EventCallback<bool> PlayerChanged { get; set; }
    [Parameter] public EventCallback<bool> LyricsChanged { get; set; }

    [Parameter] public string? Error { get; set; }
    private Task SetPlayer(bool enabled) => PlayerChanged.InvokeAsync(enabled);
    private Task SetLyrics(bool enabled) => LyricsChanged.InvokeAsync(enabled);
}
