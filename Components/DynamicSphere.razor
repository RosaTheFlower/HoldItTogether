@using HoldItTogether.Services
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject DesktopWindowService DesktopWindow

<div @ref="_area" class="sphere-area">
    <div class="dynamic-sphere @StateClass"
         tabindex="0"
         role="group"
         aria-label="HIT"
         @onwheel="HandleMenuWheelAsync"
         @onwheel:preventDefault="true"
         @onclick="PinOpen"
         @onpointerenter="HandlePointerEnter"
         @onpointerleave="HandlePointerLeave"
         @onfocusin="HandleFocusIn"
         @onfocusout="HandleFocusOut"
         @onkeydown="HandleKeyDown">
        <div class="sphere-content" inert="@(_state != SphereState.Open)">
            <header class="sphere-header">
                <h1 class="sphere-title">@_menuTitle</h1>
            <div class="sphere-actions" data-no-drag
                 @onclick:stopPropagation="true"
                 @onkeydown="HandleActionKeyDown"
                 @onkeydown:stopPropagation="true">
                <button type="button"
                        class="sphere-action sphere-action-pin @(_pinnedOpen ? "is-active" : "")"
                        aria-label="@(_pinnedOpen ? "Desfixar menu" : "Manter menu aberto")"
                        aria-pressed="@(_pinnedOpen ? "true" : "false")"
                        title="@(_pinnedOpen ? "Desfixar menu" : "Manter menu aberto")"
                        @onclick="TogglePin">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M9 3h6l-1 6 3 3v2H7v-2l3-3-1-6Z"
                              fill="@(_pinnedOpen ? "currentColor" : "none")" />
                        <path d="M12 14v7" />
                    </svg>
                </button>
                <button type="button"
                        class="sphere-action sphere-action-close"
                        aria-label="Fechar e desfixar menu"
                        title="Fechar menu"
                        @onclick="CloseSphere">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="m6 6 12 12M18 6 6 18" />
                    </svg>
                </button>
            </div>
            </header>
            <HitMenuHost @ref="_menuHost" OnCloseRequested="CloseSphere" OnTitleChanged="UpdateTitle" />
        </div>
    </div>
</div>

@code {
    private enum SphereState { Idle, Hovered, Open, Away }

    private SphereState _state = SphereState.Away;
    private CancellationTokenSource? _transitionCts;
    private ElementReference _area;
    private HitMenuHost? _menuHost;
    private string _menuTitle = "HIT";
    private void UpdateTitle(string title) => _menuTitle = title;
    private IJSObjectReference? _module;
    private DotNetObjectReference<DynamicSphere>? _reference;
    private readonly CancellationTokenSource _lifetimeCts = new();
    private Task? _pointerTracking;
    private bool _pointerInside;
    private bool _focused;
    private bool _pinnedOpen;
    private bool _suppressHoverUntilExit;
    private bool _isDragging;
    private bool _disposed;
    private bool _themePointerTracking;
    private DesktopWindowService.ThemePointer? _lastThemePointer;

    [JSInvokable]
    public void SetThemePointerTracking(bool enabled)
    {
        _themePointerTracking = enabled;
        _lastThemePointer = null;
    }

    private string StateClass =>
        $"is-{_state.ToString().ToLowerInvariant()}{(_pinnedOpen ? " is-pinned" : "")}{(_isDragging ? " is-dragging" : "")}";

    protected override void OnInitialized() => Schedule(SphereState.Idle, TimeSpan.FromSeconds(10));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dynamic-sphere.js");
        if (_disposed)
        {
            await module.DisposeAsync();
            return;
        }

        _module = module;
        _reference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("observe", _area, _reference);

        if (!_disposed && DesktopWindow.UsesNativePointerTracking)
        {
            _pointerTracking = TrackPointerAsync(_lifetimeCts.Token);
        }
    }

    [JSInvokable]
    public Task<DesktopWindowService.WindowOrigin> ResizeWindow(
        double width, double height, double scale,
        double contentLeft, double contentTop,
        double contentWidth, double contentHeight, double borderRadius)
    {
        var origin = _disposed
            ? new DesktopWindowService.WindowOrigin(0.5, 0.5)
            : DesktopWindow.ResizeToContent(
                width, height, scale, contentLeft, contentTop,
                contentWidth, contentHeight, borderRadius);
        return Task.FromResult(origin);
    }
    [JSInvokable]
    public async Task<bool> BeginDrag(double offsetX, double offsetFromBottom, double scale)
    {
        if (_disposed || !DesktopWindow.TryBeginDrag(offsetX, offsetFromBottom, scale))
        {
            return false;
        }

        CancelTransition();
        _isDragging = true;
        await InvokeAsync(StateHasChanged);
        return true;
    }

    [JSInvokable]
    public Task DragWindow()
    {
        if (!_disposed && _isDragging)
        {
            DesktopWindow.MoveDrag();
        }

        return Task.CompletedTask;
    }

    [JSInvokable]
    public async Task EndDrag()
    {
        DesktopWindow.EndDrag();

        if (_disposed)
        {
            return;
        }

        _isDragging = false;
        _pointerInside = DesktopWindow.IsPointerOverContent(_pointerInside) ?? _pointerInside;

        if (!_pinnedOpen)
        {
            CollapseIfInactive();

            if (_state is SphereState.Idle or SphereState.Away)
            {
                Schedule(SphereState.Idle, TimeSpan.FromSeconds(10));
            }
            else if (_state == SphereState.Hovered && _pointerInside)
            {
                Expand();
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private Task HandleMenuWheelAsync(WheelEventArgs args) =>
        !_disposed && !_isDragging && _state == SphereState.Open && _menuHost is not null
            ? _menuHost.HandleWheelAsync(args)
            : Task.CompletedTask;

    private void PinOpen()
    {
        if (_isDragging)
        {
            return;
        }

        CancelTransition();
        _suppressHoverUntilExit = false;
        _pinnedOpen = true;
        _state = SphereState.Open;
    }

    private void TogglePin()
    {
        if (_pinnedOpen)
        {
            _pinnedOpen = false;
            _focused = false;
            CancelTransition();
            CollapseIfInactive();
        }
        else
        {
            PinOpen();
        }
    }

    private void CloseSphere()
    {
        _pinnedOpen = false;
        _focused = false;
        _suppressHoverUntilExit = true;
        CancelTransition();
        _state = SphereState.Away;
        Schedule(SphereState.Idle, TimeSpan.FromSeconds(10));
    }

    private void HandleActionKeyDown(KeyboardEventArgs args)
    {
        // Enter/Space activate the native button; they must not reach PinOpen.
        if (args.Key == "Escape")
        {
            CloseSphere();
        }
    }

    private void HandlePointerEnter()
    {
        if (!DesktopWindow.UsesNativePointerTracking)
        {
            SetPointerInside(true);
        }
    }

    private void HandlePointerLeave()
    {
        if (!DesktopWindow.UsesNativePointerTracking)
        {
            SetPointerInside(false);
        }
    }

    private void SetPointerInside(bool inside)
    {
        if (_disposed)
        {
            return;
        }

        var changed = _pointerInside != inside;
        _pointerInside = inside;

        if (_suppressHoverUntilExit)
        {
            if (!inside)
            {
                _suppressHoverUntilExit = false;
            }
            return;
        }

        if (!changed)
        {
            return;
        }

        if (inside)
        {
            Expand();
        }
        else
        {
            CollapseIfInactive();
        }
    }
    private async Task TrackPointerAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(50));

        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(async () =>
                {
                    if (!_disposed && !_isDragging && DesktopWindow.IsPointerOverContent(_pointerInside) is bool inside &&
                        (inside != _pointerInside || _suppressHoverUntilExit))
                    {
                        SetPointerInside(inside);
                        StateHasChanged();
                    }
                    if (!_disposed && _themePointerTracking && _state != SphereState.Open &&
                        _module is not null && DesktopWindow.GetThemePointer() is { } pointer &&
                        pointer != _lastThemePointer)
                    {
                        await _module.InvokeVoidAsync("setPointer", _area, pointer.X, pointer.Y);
                        _lastThemePointer = pointer;
                    }
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (JSDisconnectedException) { }
    }

    private void HandleFocusIn()
    {
        _focused = true;
        Expand();
    }

    private void HandleFocusOut()
    {
        _focused = false;
        CollapseIfInactive();
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseSphere();
        }
        else if (args.Key is "Enter" or " ")
        {
            PinOpen();
        }
    }

    private void Expand()
    {
        if (_isDragging || _suppressHoverUntilExit)
        {
            return;
        }

        CancelTransition();

        if (_state == SphereState.Open)
        {
            return;
        }

        _state = SphereState.Hovered;
        Schedule(SphereState.Open, TimeSpan.FromMilliseconds(100));
    }

    private void CollapseIfInactive()
    {
        if (!_pointerInside && !_focused && !_pinnedOpen && !_isDragging)
        {
            // A brief grace period prevents flicker while crossing the morphing edge.
            Schedule(SphereState.Away, TimeSpan.FromMilliseconds(160));
        }
    }

    private void Schedule(SphereState nextState, TimeSpan delay)
    {
        CancelTransition();
        _transitionCts = new CancellationTokenSource();
        _ = TransitionAsync(nextState, delay, _transitionCts.Token);
    }

    private async Task TransitionAsync(SphereState nextState, TimeSpan delay, CancellationToken token)
    {
        try
        {
            await Task.Delay(delay, token);
            await InvokeAsync(() =>
            {
                if (_disposed || token.IsCancellationRequested || _isDragging || _pinnedOpen)
                {
                    return;
                }

                _state = nextState;
                StateHasChanged();

                if (nextState == SphereState.Away)
                {
                    Schedule(SphereState.Idle, TimeSpan.FromSeconds(10));
                }
            });
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void CancelTransition()
    {
        _transitionCts?.Cancel();
        _transitionCts?.Dispose();
        _transitionCts = null;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        DesktopWindow.CancelDrag();
        CancelTransition();
        _lifetimeCts.Cancel();

        if (_pointerTracking is not null)
        {
            await _pointerTracking;
        }

        _lifetimeCts.Dispose();

        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("disconnect", _area);
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The WebView can disappear before the component is disposed.
        }
        finally
        {
            _reference?.Dispose();
        }
    }
}
