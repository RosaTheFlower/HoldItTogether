@using HoldItTogether.Services
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject DesktopWindowService DesktopWindow
@inject HoldItTogether.Services.Extensions.ExtensionUi Extensions
@inject HoldItTogether.Services.Settings.HitSettingsService Settings
@inject HoldItTogether.Services.Diagnostics.HitResourcePolicy Resources
@inject HoldItTogether.Services.Extensions.HitExtensionHub ExtensionHub

<div @ref="_area" class="sphere-area" data-hit-geometry-pending="true" data-hit-resource-sleep="@(Resources.IsSleeping ? "true" : "false")"
     data-hit-opacity="@System.Text.Json.JsonSerializer.Serialize(new{enabled=Settings.Current.IdleOpacityEnabled,sphere=Settings.Current.IdleOpacitySphere,compact=Settings.Current.IdleOpacityCompact,open=Settings.Current.IdleOpacityOpen,delay=Settings.Current.IdleOpacityDelayMs,opacity=Settings.Current.IdleOpacityPercent,duration=Settings.Current.IdleOpacityTransitionMs})">
    <div class="dynamic-sphere @StateClass" data-hit-compact-delay="@Settings.Current.MenuCompactDelayMs"
         data-hit-side-buttons="@(Settings.Current.MouseSideButtonsEnabled ? "true" : "false")"
         data-hit-entry-animation="@(Settings.Current.MenuEntranceAnimations && !Settings.Current.RemoveAnimations ? "true" : "false")"
         data-hit-setting-descriptions="@(Settings.Current.ShowSettingDescriptions ? "true" : "false")"
         data-hit-show-cover-button="@(Settings.Current.ShowConfigurationCoverButton ? "true" : "false")" data-hit-hide-settings-artwork="@(Settings.Current.HideArtworkInSettings ? "true" : "false")" data-hit-title-hold="@(Settings.Current.TitleHoldEnabled ? "true" : "false")" data-hit-title-hold-delay="@Settings.Current.TitleHoldDelayMs"
         data-hit-placement="@($"{Settings.Current.WindowAllowOtherMonitors}:{Settings.Current.WindowEdgeReachPercent}")"
         tabindex="0"
         role="group"
         aria-label="@Text.Get("HIT")"
         @onwheel="HandleMenuWheelAsync"
         @onwheel:preventDefault="true"
         @onclick="PinOpen"
         @onpointerenter="HandlePointerEnter"
         @onpointerleave="HandlePointerLeave"
         @onfocusin="HandleFocusIn"
         @onfocusout="HandleFocusOut"
         @onkeydown="HandleKeyDown">
        <HoldItTogether.Components.Settings.CustomBackground Active="@(_state == SphereState.Open)" />
        <div class="sphere-audio-backdrop" aria-hidden="true"></div>
        <div class="sphere-content" inert="@(_state != SphereState.Open)">
            <header class="sphere-header" hidden="@_compactMenu" inert="@_compactMenu">
                <div class="sphere-heading">
                @if (_canGoBack)
                {
                    <button type="button" class="sphere-action sphere-action-back" data-no-drag aria-label="@Text.Get("Back")" title="@Text.Get("Back")"
                            @onclick="GoBackAsync" @onclick:stopPropagation="true" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true" @onkeydown:stopPropagation="true">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg>
                    </button>
                }
                <h1 class="sphere-title @(_hasMenuSettings ? "has-settings" : "")"
                    tabindex="@(_hasMenuSettings ? 0 : -1)"
                    data-hit-menu-trigger="@(_hasMenuSettings ? "settings" : null)"
                    title="@(_hasMenuSettings ? "Right-click to configure this menu" : null)"
                    @oncontextmenu="OpenMenuSettingsAsync" @oncontextmenu:preventDefault="true"
                    @oncontextmenu:stopPropagation="true" @onkeydown="HandleTitleKeyAsync" @onkeydown:stopPropagation="true" aria-label="@_menuTitle">
@if(Settings.Current.TitleDisplayMode!=0){@if(TitleIcon is { } icon){<svg class="sphere-title-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="@icon" /></svg>}else{<HitSettingsIcon />}}
@if(Settings.Current.TitleDisplayMode!=2){<span>@_menuTitle</span>}
</h1>
                </div>
            <div class="sphere-actions" data-no-drag
                 @onclick:stopPropagation="true"
                 @onkeydown="HandleActionKeyDown"
                 @onkeydown:stopPropagation="true">
                <button type="button" class="sphere-action sphere-action-reading-cover" data-hit-reading-cover data-no-drag hidden
                        aria-label="Hide artwork for this screen" aria-pressed="true" title="Hide artwork for this screen">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <rect x="3" y="4" width="18" height="16" rx="3" /><circle cx="8" cy="9" r="1.5" />
                        <path d="m4 17 5-5 4 4 3-3 5 5" /><path class="reading-cover-slash" d="m3 3 18 18" />
                    </svg>
                </button>
                <button type="button"
                        class="sphere-action sphere-action-pin @(_pinnedOpen ? "is-active" : "")"
                        aria-label="@(_pinnedOpen ? "Unpin menu" : "Keep menu open")"
                        aria-pressed="@(_pinnedOpen ? "true" : "false")"
                        title="@(_pinnedOpen ? "Unpin menu" : "Keep menu open")"
                        @onclick="TogglePin">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M9 3h6l-1 6 3 3v2H7v-2l3-3-1-6Z"
                              fill="@(_pinnedOpen ? "currentColor" : "none")" />
                        <path d="M12 14v7" />
                    </svg>
                </button>
                <button type="button"
                        class="sphere-action sphere-action-close"
                        aria-label="@Text.Get("Close and unpin menu")"
                        title="@Text.Get("Close menu")"
                        @onclick="CloseSphere">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="m6 6 12 12M18 6 6 18" />
                    </svg>
                </button>
            </div>
            </header>
            <HitMenuHost @ref="_menuHost" OnCloseRequested="CloseSphere" OnTitleChanged="UpdateTitle"
                         OnSettingsAvailableChanged="UpdateSettingsAvailable" OnBackAvailableChanged="UpdateBackAvailable" OnLayoutChanged="UpdateLayout"
                         OnPinRequested="SetPinned"
                         IsPinned="@_pinnedOpen" IsVisible="@(_state == SphereState.Open && !Resources.IsSleeping)" />
            <HoldItTogether.Components.Clock.ClockNotifications />
            <HoldItTogether.Components.Extensions.ExtensionNotification />
        </div>
    </div>
</div>

@code {
    private enum SphereState { Idle, Hovered, Open, Away }

    private SphereState _state = SphereState.Away;
    private CancellationTokenSource? _transitionCts;
    private ElementReference _area;
    private HitMenuHost? _menuHost;
    private string _menuTitle = "HIT";
    private bool _hasMenuSettings;
    private bool _canGoBack;
    [JSInvokable] public void PublishHostState(bool open,bool compact,bool pinned)=>ExtensionHub.PublishHost(!open?HIT.Sdk.HitSurfaceState.Collapsed:compact?HIT.Sdk.HitSurfaceState.Compact:HIT.Sdk.HitSurfaceState.Open,DesktopWindow.IsVisible,pinned);
    [JSInvokable] public Task OpenSettingsFromHold() => !_disposed&&Settings.Current.TitleHoldEnabled&&_menuHost?.IsConfiguration==false?OpenMenuSettingsAsync():Task.CompletedTask;
    [JSInvokable] public Task NavigateMouse(int direction,bool contextOnly) => _disposed||_menuHost is null||
        (direction!=-1&&direction!=1)||(!contextOnly&&!Settings.Current.MouseSideButtonsEnabled)
        ?Task.CompletedTask:_menuHost.NavigateMouseAsync(direction,contextOnly);
    [JSInvokable]
    public Task<bool> CompactCurrentMenu() => !_disposed && _menuHost is not null ? _menuHost.CompactCurrentAsync() : Task.FromResult(false);
    private bool _compactMenu;
    private void UpdateLayout(HoldItTogether.Services.HitMenus.HitMenuLayout layout) =>
        _compactMenu = layout == HoldItTogether.Services.HitMenus.HitMenuLayout.Compact;
    private string? TitleIcon => (_menuTitle??"").ToLowerInvariant() switch {"audio"=>"M5 9v6m5-11v16m5-13v10m5-7v4", "lyrics"=>"M9 18V5l12-2v13M9 9l12-2M9 18a3 3 0 1 1-3-3c2 0 3 1 3 3m12-2a3 3 0 1 1-3-3c2 0 3 1 3 3", "clock"=>"M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18m0 4v5l4 2", "chess"=>"M5 21h14v-3H7c0-4 4-5 7-8l-4 1-3 3-3-3 2-5 4-3 1-2 3 2c6 0 7 6 5 11l-1 4M12 7h.01", _=>null};
    private void UpdateTitle(string title) => _menuTitle = title;
    private void UpdateSettingsAvailable(bool available) => _hasMenuSettings = available;
    private void UpdateBackAvailable(bool available) => _canGoBack = available;
    private Task GoBackAsync() => _menuHost?.GoBackAsync() ?? Task.CompletedTask;
    private Task OpenMenuSettingsAsync() => _hasMenuSettings && _menuHost is not null
        ? _menuHost.OpenCurrentSettingsAsync() : Task.CompletedTask;
    private Task HandleTitleKeyAsync(KeyboardEventArgs args)
    {
        if (args.Key == "ContextMenu" || (args.ShiftKey && args.Key == "F10") || args.Key is "Enter" or " ")
            return OpenMenuSettingsAsync();
        if (args.Key == "Escape") CloseSphere();
        return Task.CompletedTask;
    }
    private IJSObjectReference? _module;
    private DotNetObjectReference<DynamicSphere>? _reference;
    private readonly CancellationTokenSource _lifetimeCts = new();
    private Task? _pointerTracking;
    private bool _pointerInside;
    private bool _focused;
    private bool _pinnedOpen;
    private bool _suppressHoverUntilExit;
    private bool _isDragging;
    private bool _disposed;
    private long _navigationActiveUntil;
    private bool _themePointerTracking;
    private DesktopWindowService.ThemePointer? _lastThemePointer;

    [JSInvokable]
    public void SetThemePointerTracking(bool enabled)
    {
        _themePointerTracking = enabled;
        _lastThemePointer = null;
    }

    private string StateClass =>
        $"is-{_state.ToString().ToLowerInvariant()}{(_pinnedOpen ? " is-pinned" : "")}{(_isDragging ? " is-dragging" : "")}{(_compactMenu ? " is-menu-compact" : "")}";

    protected override void OnInitialized()
    {
        Extensions.OpenRequested += ShowExtensions;
        Settings.Changed += SettingsChanged;
        Resources.Changed += ResourceStateChanged;
        Schedule(SphereState.Idle, TimeSpan.FromSeconds(10));
        if (Extensions.ShowExtensions || Extensions.ShowThemes) PinOpen();
    }
    private void SettingsChanged() { if (!_disposed) _ = InvokeAsync(() => { if (!Settings.Current.AutomaticResourceSaving) Resources.Wake(); StateHasChanged(); }); }
    private void ResourceStateChanged() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }
    private void SetPinned(bool pinned) { if (pinned) PinOpen(); else _pinnedOpen = false; }
    private void ShowExtensions()
    {
        if (!_disposed) _ = InvokeAsync(async () =>
        {
            PinOpen();
            if (_menuHost is not null) await _menuHost.ShowExtensionsAsync();
            StateHasChanged();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/dynamic-sphere.js");
        if (_disposed)
        {
            await module.DisposeAsync();
            return;
        }

        _module = module;
        _reference = DotNetObjectReference.Create(this);
        if ((Extensions.ShowExtensions || Extensions.ShowThemes) && _menuHost is not null) await _menuHost.ShowExtensionsAsync();
        await _module.InvokeVoidAsync("observe", _area, _reference);

        if (!_disposed && DesktopWindow.UsesNativePointerTracking)
        {
            _pointerTracking = TrackPointerAsync(_lifetimeCts.Token);
        }
    }

    [JSInvokable]
    public DesktopWindowService.WindowOrigin PrepareSurface() => DesktopWindow.PrepareSurface();
    [JSInvokable]
    public Task<DesktopWindowService.WindowOrigin> ResizeWindow(
        double width, double height, double scale,
        double contentLeft, double contentTop,
        double contentWidth, double contentHeight, double borderRadius)
    {
        var origin = _disposed
            ? new DesktopWindowService.WindowOrigin(0.5, 0.5)
            : DesktopWindow.ResizeToContent(
                width, height, scale, contentLeft, contentTop,
                contentWidth, contentHeight, borderRadius);
        return Task.FromResult(origin);
    }
    [JSInvokable]
    public async Task<bool> BeginDrag(double offsetX, double offsetY, double scale)
    {
        if (_disposed || !DesktopWindow.TryBeginDrag(offsetX, offsetY, scale))
        {
            return false;
        }

        CancelTransition();
        _isDragging = true;
        await InvokeAsync(StateHasChanged);
        return true;
    }

    [JSInvokable]
    public Task DragWindow()
    {
        if (!_disposed && _isDragging)
        {
            DesktopWindow.MoveDrag();
        }

        return Task.CompletedTask;
    }

    [JSInvokable]
    public async Task<DesktopWindowService.WindowOrigin> EndDrag()
    {
        var origin = DesktopWindow.EndDrag();

        if (_disposed)
        {
            return origin;
        }

        _isDragging = false;
        _pointerInside = DesktopWindow.IsPointerOverContent(_pointerInside) ?? _pointerInside;

        if (!_pinnedOpen)
        {
            CollapseIfInactive();

            if (_state is SphereState.Idle or SphereState.Away)
            {
                Schedule(SphereState.Idle, TimeSpan.FromSeconds(10));
            }
            else if (_state == SphereState.Hovered && _pointerInside)
            {
                Expand();
            }
        }

        await InvokeAsync(StateHasChanged);
        return origin;
    }

    private async Task HandleMenuWheelAsync(WheelEventArgs args)
    {
        if (_disposed || _isDragging || _state != SphereState.Open || _menuHost is null) return;
        _navigationActiveUntil = Environment.TickCount64 + 1000;
        CancelTransition();
        await _menuHost.HandleWheelAsync(args);
        CollapseIfInactive();
    }

    private void PinOpen()
    {
        Resources.Wake();
        if (_isDragging)
        {
            return;
        }

        CancelTransition();
        _suppressHoverUntilExit = false;
        _pinnedOpen = true;
        _state = SphereState.Open;
    }

    private void TogglePin()
    {
        if (_pinnedOpen)
        {
            _pinnedOpen = false;
            _focused = false;
            CancelTransition();
            CollapseIfInactive();
        }
        else
        {
            PinOpen();
        }
    }

    private void CloseSphere()
    {
        _pinnedOpen = false;
        _focused = false;
        _suppressHoverUntilExit = true;
        CancelTransition();
        _state = SphereState.Away;
        Schedule(SphereState.Idle, TimeSpan.FromSeconds(10));
    }

    private void HandleActionKeyDown(KeyboardEventArgs args)
    {
        // Enter/Space activate the native button; they must not reach PinOpen.
        if (args.Key == "Escape")
        {
            CloseSphere();
        }
    }

    private void HandlePointerEnter()
    {
        Resources.Wake();
        if (!DesktopWindow.UsesNativePointerTracking)
        {
            SetPointerInside(true);
        }
    }

    private void HandlePointerLeave()
    {
        if (!DesktopWindow.UsesNativePointerTracking)
        {
            SetPointerInside(false);
        }
    }

    private void SetPointerInside(bool inside)
    {
        if (_disposed)
        {
            return;
        }

        var changed = _pointerInside != inside;
        _pointerInside = inside;

        if (_suppressHoverUntilExit)
        {
            if (!inside)
            {
                _suppressHoverUntilExit = false;
            }
            return;
        }

        if (!changed)
        {
            return;
        }

        if (inside)
        {
            Expand();
        }
        else
        {
            CollapseIfInactive();
        }
    }
    private async Task TrackPointerAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(50));

        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                // Keep native wake detection responsive without dispatching idle work to Blazor.
                if (Resources.IsSleeping && DesktopWindow.IsPointerOverContent(false) != true &&
                    (_state != SphereState.Open || DesktopWindow.IsCoveredByFullscreen)) continue;
                await InvokeAsync(async () =>
                {
                    if (!_disposed && !_isDragging && DesktopWindow.IsPointerOverContent(_pointerInside) is bool inside &&
                        (inside != _pointerInside || _suppressHoverUntilExit))
                    {
                        SetPointerInside(inside);
                        StateHasChanged();
                    }
                    if (!_disposed)
                    {
                        var covered = DesktopWindow.IsCoveredByFullscreen;
                        Resources.Update(Settings.Current.AutomaticResourceSaving,
                            _state is SphereState.Idle or SphereState.Away, covered,
                            _pointerInside || _isDragging || (_focused && !covered), Environment.TickCount64);
                    }
                    if (!_disposed && !Resources.IsSleeping && _themePointerTracking && _state != SphereState.Open &&
                        _module is not null && DesktopWindow.GetThemePointer() is { } pointer &&
                        pointer != _lastThemePointer)
                    {
                        await _module.InvokeVoidAsync("setPointer", _area, pointer.X, pointer.Y);
                        _lastThemePointer = pointer;
                    }
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (JSDisconnectedException) { }
    }

    private void HandleFocusIn()
    {
        _focused = true;
        Expand();
    }

    private void HandleFocusOut()
    {
        _focused = false;
        CollapseIfInactive();
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseSphere();
        }
        else if (args.Key is "Enter" or " ")
        {
            PinOpen();
        }
    }

    private void Expand()
    {
        Resources.Wake();
        if (_isDragging || _suppressHoverUntilExit)
        {
            return;
        }

        CancelTransition();

        if (_state == SphereState.Open)
        {
            return;
        }

        _state = SphereState.Hovered;
        Schedule(SphereState.Open, TimeSpan.FromMilliseconds(100));
    }

    private void CollapseIfInactive()
    {
        if (!_pointerInside && !_focused && !_pinnedOpen && !_isDragging)
        {
            // A brief grace period prevents flicker while crossing the morphing edge.
            Schedule(SphereState.Away, TimeSpan.FromMilliseconds(Math.Max(160, _navigationActiveUntil - Environment.TickCount64)));
        }
    }

    private void Schedule(SphereState nextState, TimeSpan delay)
    {
        CancelTransition();
        _transitionCts = new CancellationTokenSource();
        _ = TransitionAsync(nextState, delay, _transitionCts.Token);
    }

    private async Task TransitionAsync(SphereState nextState, TimeSpan delay, CancellationToken token)
    {
        try
        {
            await Task.Delay(delay, token);
            await InvokeAsync(() =>
            {
                if (_disposed || token.IsCancellationRequested || _isDragging || _pinnedOpen)
                {
                    return;
                }

                _state = nextState;
                StateHasChanged();

                if (nextState == SphereState.Away)
                {
                    Schedule(SphereState.Idle, TimeSpan.FromSeconds(10));
                }
            });
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void CancelTransition()
    {
        _transitionCts?.Cancel();
        _transitionCts?.Dispose();
        _transitionCts = null;
    }

    public async ValueTask DisposeAsync()
    {
        Extensions.OpenRequested -= ShowExtensions;
        Settings.Changed -= SettingsChanged;
        Resources.Changed -= ResourceStateChanged;
        _disposed = true;
        DesktopWindow.CancelDrag();
        CancelTransition();
        _lifetimeCts.Cancel();

        if (_pointerTracking is not null)
        {
            await _pointerTracking;
        }

        _lifetimeCts.Dispose();

        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("disconnect", _area);
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The WebView can disappear before the component is disposed.
        }
        finally
        {
            _reference?.Dispose();
        }
    }
}
