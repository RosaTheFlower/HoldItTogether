@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using HoldItTogether.Services.Extensions
@using HoldItTogether.Services.HitMenus
@implements IAsyncDisposable
@inject ExtensionStore Store
@inject ExtensionRuntime Runtime
@inject HitMenuCatalog Catalog
@inject ExtensionUi Ui
@inject IJSRuntime JS

<section class="extensions-view" data-no-drag @onclick:stopPropagation="true" @onwheel:stopPropagation="true"
         @oncontextmenu="Back" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true"
         @onkeydown="HandleKey" @onkeydown:stopPropagation="true">
    <div class="extensions-toolbar">
        <button type="button" class="extension-back" @onclick="Back" title="@Text.Get("Back to Settings (right-click)")" aria-label="@Text.Get("Back to Settings")">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m11 5-5 5 5 5M6 10h10" /></svg><span>@Text.Get("Settings")</span>
        </button>
        <label class="extension-install @(_busy ? "is-busy" : "")">
            <span>@(_busy ? "Installing…" : Text.Get("Install .hitmenu"))</span>
            <InputFile accept=".hitmenu" OnChange="Import" disabled="@_busy" aria-label="@Text.Get("Install extension")" />
        </label>
    </div>
    <p class="extensions-hint">@Text.Get("Drag menus to reorder. Drop a .hitmenu anywhere on HIT to install.")</p>
    @if (Ui.Message is { } message)
    {
        <p class="extension-message @(Ui.IsError ? "is-error" : "")" role="status">@message</p>
    }
    @if (Store.Error is { } error) { <p class="extension-message is-error" role="alert">@error</p> }
    <div class="extensions-list" role="list" aria-label="@Text.Get("Menu order")" @onwheel:stopPropagation="true">
        @foreach (var menu in Catalog.All)
        {
            var item = menu;
            var builtin = item.ExtensionId is null;
            var locked = item.Id == HitMenuCatalog.SettingsId;
            var package = Store.State.Packages.FirstOrDefault(package => package.Manifest.Id == item.ExtensionId);
            var enabled = Store.IsEnabled(item.Id);
            <div @key="item.Id" class="extension-row @(_dragging == item.Id ? "is-dragging" : "") @(!enabled ? "is-disabled" : "")"
                 role="listitem" draggable="@(!locked ? "true" : "false")" data-extension-id="@item.Id"
                 @ondragstart="() => _dragging = item.Id" @ondragend="() => _dragging = null"
                 @ondragover:preventDefault="true" @ondrop="() => Drop(item.Id)" @ondrop:stopPropagation="true">
                <span class="extension-grip" aria-hidden="true">@(locked ? "·" : "⠿")</span>
                <div class="extension-identity">
                    <strong>@item.Name</strong>
                    <span>@(builtin ? Text.Get("Built-in") : package?.Manifest.Name + " · " + package?.Manifest.Version)</span>
                    @if (!enabled && !builtin && Runtime.LoadedVersions.ContainsKey(item.ExtensionId!))
                    { <span>@Text.Get("Disabled. Restart to stop extension services.")</span> }
                    @if (item.ExtensionId is { } extensionId && Runtime.Errors.TryGetValue(extensionId, out var failure))
                    { <span class="extension-failure">@failure</span> }
                    else if (!builtin && (item.ComponentType is null || Runtime.LoadedVersions.GetValueOrDefault(item.ExtensionId!) != package?.Manifest.Version))
                    { <span>@Text.Get("Restart HIT to activate")</span> }
                    @if (package?.PreviousVersion is not null)
                    {
                        <button type="button" class="extension-rollback" @onclick="() => Restore(package.Manifest.Id)">@Text.Get("Restore previous version")</button>
                    }
                </div>
                <div class="extension-actions">
                    <button type="button" class="extension-icon" disabled="@(locked || IsFirst(item.Id))" title="@Text.Get("Move up")" aria-label="@($"Move {item.Name} up")" @onclick="() => Move(item.Id, -1)">↑</button>
                    <button type="button" class="extension-icon" disabled="@(locked || IsLast(item.Id))" title="@Text.Get("Move down")" aria-label="@($"Move {item.Name} down")" @onclick="() => Move(item.Id, 1)">↓</button>
                    <input class="extension-switch" type="checkbox" role="switch" checked="@(locked || enabled)" disabled="@locked"
                           aria-label="@($"Enable {item.Name}")" @onchange="args => Enable(item.Id, args.Value is true)" />
                    @if (!builtin)
                    {
                        <button type="button" class="extension-icon" title="@Text.Get("Remove extension")" aria-label="@($"Remove {package?.Manifest.Name}")" @onclick="() => AskRemove(package!)">
                            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 6h12M8 3h4M6 6l1 11h6l1-11M9 9v5m2-5v5" /></svg>
                        </button>
                    }
                </div>
            </div>
        }
    </div>
    @if (Store.State.Packages.Any(package => package.PendingDelete))
    { <p class="extensions-hint">@Text.Get("Removed extensions will be cleaned up when HIT restarts. Their saved data is kept.")</p> }
    <dialog @ref="_dialog" class="theme-delete-dialog extension-dialog" aria-labelledby="extension-delete-title"
            @oncontextmenu:stopPropagation="true" @onwheel:stopPropagation="true" @onclick:stopPropagation="true">
        <h2 id="extension-delete-title">@Text.Get("Remove extension?")</h2>
        <p>@_pending?.Manifest.Name and all its menus will be removed. Saved data will be kept.</p>
        <div class="dialog-actions">
            <button type="button" data-dialog-cancel @onclick="CancelRemove">@Text.Get("Cancel")</button>
            <button type="button" class="confirm-delete" @onclick="ConfirmRemove">@Text.Get("Remove")</button>
        </div>
    </dialog>
</section>

@code {
    [Parameter] public EventCallback BackRequested { get; set; }
    private readonly CancellationTokenSource _lifetime = new();
    private bool _busy, _disposed, _dialogOpen;
    private string? _dragging;
    private InstalledExtension? _pending;
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    protected override void OnInitialized() { Store.Changed += Refresh; Ui.Changed += Refresh; }
    private void Refresh() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }
    private Task Back() => BackRequested.InvokeAsync();
    private Task HandleKey(KeyboardEventArgs args) => args.Key == "Escape" && _pending is null ? Back() : Task.CompletedTask;
    private bool IsFirst(string id) => Catalog.All.FirstOrDefault()?.Id == id;
    private bool IsLast(string id) => Catalog.All.LastOrDefault(item => item.Id != HitMenuCatalog.SettingsId)?.Id == id;
    private void Run(Action action)
    {
        try { action(); }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException or InvalidOperationException) { Ui.Report(error.Message, true); }
    }
    private void Enable(string id, bool enabled) => Run(() => Store.SetEnabled(id, enabled));
    private void Restore(string id) => Run(() => { Store.RestorePrevious(id); Ui.Report("Previous version restored. Restart HIT to activate it."); });
    private void Move(string id, int direction)
    {
        var menus = Catalog.All.Where(menu => menu.Id != HitMenuCatalog.SettingsId).ToArray();
        var index = Array.FindIndex(menus, menu => menu.Id == id);
        if (index + direction >= 0 && index + direction < menus.Length) Run(() => Catalog.Move(id, menus[index + direction].Id));
    }
    private void Drop(string target)
    {
        if (_dragging is { } source) Run(() => Catalog.Move(source, target));
        _dragging = null;
    }
    private void AskRemove(InstalledExtension package) => _pending = package;
    private void CancelRemove() => _pending = null;
    private void ConfirmRemove()
    {
        if (_pending is { } package) Run(() => { Store.Remove(package.Manifest.Id); Ui.Report("Extension removed. Restart HIT to finish cleanup."); });
        _pending = null;
    }
    private async Task Import(InputFileChangeEventArgs args)
    {
        if (_busy) return; _busy = true;
        try
        {
            await using var stream = args.File.OpenReadStream(ExtensionStore.MaxPackageBytes, _lifetime.Token);
            var package = await Store.InstallAsync(stream, args.File.Name, _lifetime.Token);
            Ui.Report($"{package.Manifest.Name} installed. Restart HIT to activate it.");
        }
        catch (OperationCanceledException) { }
        catch (Exception error) { Ui.Report("Installation failed: " + error.GetBaseException().Message, true); }
        finally { _busy = false; }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_dialogOpen == (_pending is not null)) return;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/hit-themes.js");
        await _module.InvokeVoidAsync("setDeleteDialog", _dialog, _pending is not null);
        _dialogOpen = _pending is not null;
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true; Store.Changed -= Refresh; Ui.Changed -= Refresh;
        _lifetime.Cancel(); _lifetime.Dispose();
        if (_module is not null) try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
