@using Microsoft.AspNetCore.Components.Forms
@using System.Text.Json
@using Microsoft.JSInterop
@using HoldItTogether.Services.Extensions
@using HoldItTogether.Services.HitMenus
@implements IAsyncDisposable
@inject ExtensionStore Store
@inject ExtensionUpdateService Updates
@inject ExtensionRuntime Runtime
@inject HitMenuCatalog Catalog
@inject ExtensionUi Ui
@inject ExtensionActivationService Activation
@inject IJSRuntime JS

<section @ref="_root" class="extensions-view" data-no-drag @onclick:stopPropagation="true"
         @oncontextmenu="Back" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true"
         @onkeydown="HandleKey" @onkeydown:stopPropagation="true">
    <div class="extensions-toolbar">
        <h2>@Text.Get("Extensions")</h2>
        @if (ShowBack) { <button type="button" class="extension-back" @onclick="Back" title="@Text.Get("Back to Settings (right-click)")" aria-label="@Text.Get("Back to Settings")">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m11 5-5 5 5 5M6 10h10" /></svg><span>@Text.Get("Settings")</span>
        </button> }
        <label class="extension-install hit-busy-action @(_busy ? "is-busy" : "")" aria-busy="@(_busy ? "true" : "false")">
            <span class="hit-busy-label">@Text.Get("Install .hitmenu")</span>
            @if(_busy){<span class="hit-busy-indicator"><HitSpinner /></span>}
            <InputFile accept=".hitmenu" OnChange="Import" disabled="@_busy" aria-label="@Text.Get("Install extension")" />
        </label>
    </div>
    <p class="extensions-hint">@Text.Get("Drag menus to reorder. Drop a .hitmenu anywhere on HIT to install.")</p>
    <button type="button" class="hit-button" disabled="@_busy" @onclick="CheckUpdatesAsync">
        @if (_busy) { <HitSpinner /> } @Text.Get("Check for extension updates")
    </button>
    @if (Ui.Message is { } message)
    {
        <p class="extension-message @(Ui.IsError ? "is-error" : "")" role="status">@if(Ui.IsBusy){<HitSpinner Label="@message" />}else{@message}</p>
    }
    @if (Store.Error is { } error) { <p class="extension-message is-error" role="alert">@error</p> }
    <div class="extensions-list" role="list" aria-label="@Text.Get("Menu order")">
        @foreach (var menu in Catalog.All)
        {
            var item = menu;
            var builtin = item.ExtensionId is null;
            var locked = item.Id == HitMenuCatalog.SettingsId;
            var package = Store.State.Packages.FirstOrDefault(package => package.Manifest.Id == item.ExtensionId);
            var enabled = Store.IsEnabled(item.Id);
            <div @key="item.Id" class="extension-row @(!enabled ? "is-disabled" : "")"
                 role="listitem" data-extension-id="@item.Id" data-order-locked="@(locked ? "true" : "false")">
                <button type="button" class="extension-grip" disabled="@locked" aria-label="@($"Drag {item.Name} to reorder")">@(locked ? "·" : "⠿")</button>
                <div class="extension-identity">
                    <strong>@item.Name</strong>
                    <span>@(builtin ? Text.Get("Built-in") : package?.Manifest.Name + " · " + package?.Manifest.Version)</span>
                    @if (!enabled && !builtin && Runtime.LoadedVersions.ContainsKey(item.ExtensionId!))
                    { <span>@Text.Get("Disabled. Restart to stop extension services.")</span> }
                    @if (item.ExtensionId is { } extensionId && Runtime.Errors.TryGetValue(extensionId, out var failure))
                    { <span class="extension-failure">@failure</span> }
                    else if (!builtin && item.ComponentType is null)
                    { <span>@Text.Get("Enable to activate")</span> }
                    @if (package?.PreviousVersion is not null)
                    {
                        <button type="button" class="extension-rollback" @onclick="() => Restore(package.Manifest.Id)">@Text.Get("Restore previous version")</button>
                    }
                    @if (package is not null && _updates.TryGetValue(package.Manifest.Id, out var update))
                    {
                        <button type="button" class="hit-button" disabled="@_busy" @onclick="() => InstallUpdateAsync(update)">@Text.Format("Update to {0}", update.Version)</button>
                    }
                </div>
                <div class="extension-actions">
                    <button type="button" class="extension-icon" disabled="@(locked || IsFirst(item.Id))" title="@Text.Get("Move up")" aria-label="@($"Move {item.Name} up")" @onclick="() => Move(item.Id, -1)">↑</button>
                    <button type="button" class="extension-icon" disabled="@(locked || IsLast(item.Id))" title="@Text.Get("Move down")" aria-label="@($"Move {item.Name} down")" @onclick="() => Move(item.Id, 1)">↓</button>
                    <input class="extension-switch" type="checkbox" role="switch" checked="@(locked || enabled)" disabled="@locked"
                           aria-label="@($"Enable {item.Name}")" @onchange="args => Enable(item.Id, args.Value is true)" />
                        <button type="button" class="extension-icon" disabled="@builtin" title="@(builtin ? "Built-in menus cannot be removed" : "Remove extension")" aria-label="@($"Remove {item.Name}")" @onclick="() => AskRemove(package!)">
                            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 6h12M8 3h4M6 6l1 11h6l1-11M9 9v5m2-5v5" /></svg>
                        </button>
                </div>
            </div>
        }
    </div>
    @if (Store.State.Packages.Any(package => package.PendingDelete))
    { <p class="extensions-hint">@Text.Get("Removed extensions will be cleaned up when HIT restarts. Their saved data is kept.")</p> }
    <button type="button" class="hit-button extensions-clear" aria-label="Clear old versions" disabled="@_busy" @onclick="ClearOldVersions">Clear old versions</button>
    <dialog @ref="_dialog" class="theme-delete-dialog extension-dialog hit-confirm" aria-labelledby="extension-delete-title" @oncancel="CancelRemove"
            @oncontextmenu="CancelRemove" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true" @onwheel:stopPropagation="true" @onclick:stopPropagation="true">
        <h2 id="extension-delete-title">@Text.Get("Remove extension?")</h2>
        <p>@_pending?.Manifest.Name and all its menus will be removed. Saved data will be kept.</p>
        <div class="dialog-actions">
            <button type="button" data-dialog-cancel @onclick="CancelRemove">@Text.Get("Cancel")</button>
            <button type="button" class="is-primary" @onclick="ConfirmRemove">@Text.Get("Remove")</button>
        </div>
    </dialog>
</section>

@code {
    [Parameter] public EventCallback BackRequested { get; set; }
    [Parameter] public bool ShowBack { get; set; } = true;
    private readonly CancellationTokenSource _lifetime = new();
    private readonly Dictionary<string, ExtensionUpdate> _updates = new();
    private Task? _updateWork;
    private Task CheckUpdatesAsync() => _updateWork = RunCheckUpdatesAsync();
    private async Task RunCheckUpdatesAsync()
    {
        if (_busy || _disposed) return;
        _busy = true; _updates.Clear();
        var failures = 0;
        try
        {
            foreach (var package in Store.State.Packages.Where(p => !p.PendingDelete && ExtensionUpdateService.SourceFor(p.Manifest) is not null))
            {
                try { if (await Updates.CheckAsync(package, _lifetime.Token) is { } update) _updates[package.Manifest.Id] = update; }
                catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { throw; }
                catch (Exception error) when (error is HttpRequestException or IOException or JsonException or OperationCanceledException or InvalidOperationException or KeyNotFoundException) { failures++; }
            }
            if (!_disposed) Ui.Report(Text.Get(failures > 0 ? "Some extension updates could not be checked. Try again." : _updates.Count > 0 ? "Extension updates are available below." : "All supported extensions are up to date."), failures > 0);
        }
        catch (OperationCanceledException) { }
        finally { _busy = false; }
    }
    private Task InstallUpdateAsync(ExtensionUpdate update) => _updateWork = RunInstallUpdateAsync(update);
    private async Task RunInstallUpdateAsync(ExtensionUpdate update)
    {
        if (_busy || _disposed) return;
        _busy = true;
        try
        {
            var package = await Updates.InstallAsync(update, _lifetime.Token);
            _updates.Remove(package.Manifest.Id);
            if (!_disposed) await Activation.ActivateAsync(package.Manifest.Id, package.Manifest.Name);
        }
        catch (OperationCanceledException) { }
        catch (Exception error) { if (!_disposed) Ui.Report(Text.Get("Extension update failed.") + " " + error.GetBaseException().Message, true); }
        finally { _busy = false; }
    }
    private bool _busy, _disposed, _dialogOpen;
    private InstalledExtension? _pending;
    private ElementReference _dialog;
    private ElementReference _root;
    private IJSObjectReference? _module;
    private IJSObjectReference? _orderModule;
    private DotNetObjectReference<ExtensionsView>? _reference;
    protected override void OnInitialized() { Store.Changed += Refresh; Ui.Changed += Refresh; }
    private void Refresh() { if (!_disposed) _ = InvokeAsync(StateHasChanged); }
    private Task Back() => BackRequested.InvokeAsync();
    private Task HandleKey(KeyboardEventArgs args) => args.Key == "Escape" && _pending is null ? Back() : Task.CompletedTask;
    private bool IsFirst(string id) => Catalog.All.FirstOrDefault()?.Id == id;
    private bool IsLast(string id) => Catalog.All.LastOrDefault(item => item.Id != HitMenuCatalog.SettingsId)?.Id == id;
    private void Run(Action action)
    {
        try { action(); }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException or InvalidOperationException) { Ui.Report(error.Message, true); }
    }
    private async Task Enable(string id, bool enabled)
    {
        Run(() => Store.SetEnabled(id, enabled));
        if (enabled && Catalog.All.FirstOrDefault(menu => menu.Id == id)?.ExtensionId is { } package) await Activate(package);
    }
    private async Task Restore(string id) { Run(() => Store.RestorePrevious(id)); await Activate(id); }
    private async Task Activate(string id)
    {
        try { await Activation.ActivateAsync(id, Store.State.Packages.First(item => item.Manifest.Id == id).Manifest.Name); }
        catch (Exception error) when (error is IOException or InvalidOperationException or System.ComponentModel.Win32Exception) { Ui.Report(error.Message, true); }
    }
    private void Move(string id, int direction)
    {
        var menus = Catalog.All.Where(menu => menu.Id != HitMenuCatalog.SettingsId).ToArray();
        var index = Array.FindIndex(menus, menu => menu.Id == id);
        if (index + direction >= 0 && index + direction < menus.Length) Run(() => Catalog.Move(id, menus[index + direction].Id));
    }
    [JSInvokable] public Task Reorder(string source, string target, bool after) => _disposed ? Task.CompletedTask : InvokeAsync(() => { if (!_disposed) { Run(() => Catalog.Place(source, target, after)); StateHasChanged(); } });
    private void AskRemove(InstalledExtension package) => _pending = package;
    private async Task ClearOldVersions()
    {
        if (_busy || _disposed) return; _busy = true;
        try
        {
            var result = await Runtime.ClearOldVersionsAsync(_lifetime.Token);
            Ui.Report($"Removed {result.Removed} old version(s)." + (result.Skipped > 0 ? $" {result.Skipped} could not be removed." : ""));
        }
        catch (OperationCanceledException) { }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException) { Ui.Report("Could not clean old extension versions. Close other HIT instances and try again.",true); }
        finally { _busy = false; }
    }
    private void CancelRemove() => _pending = null;
    private void ConfirmRemove()
    {
        if (_pending is { } package) Run(() => { Store.Remove(package.Manifest.Id); Ui.Report("Extension removed. Restart HIT to finish cleanup."); });
        _pending = null;
    }
    private async Task Import(InputFileChangeEventArgs args)
    {
        if (_busy) return; _busy = true;
        try
        {
            await using var stream = args.File.OpenReadStream(ExtensionStore.MaxPackageBytes, _lifetime.Token);
            var package = await Store.InstallAsync(stream, args.File.Name, _lifetime.Token);
            await Activation.ActivateAsync(package.Manifest.Id, package.Manifest.Name);
        }
        catch (OperationCanceledException) { }
        catch (Exception error) { Ui.Report("Installation failed: " + error.GetBaseException().Message, true); }
        finally { _busy = false; }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _orderModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/hit-extensions.js");
            if (_disposed) { await _orderModule.DisposeAsync(); return; }
            _reference = DotNetObjectReference.Create(this);
            await _orderModule.InvokeVoidAsync("connectOrder", _root, _reference);
        }
        if (_dialogOpen == (_pending is not null)) return;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/hit-themes.js");
        await _module.InvokeVoidAsync("setDeleteDialog", _dialog, _pending is not null);
        _dialogOpen = _pending is not null;
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true; Store.Changed -= Refresh; Ui.Changed -= Refresh;
        _lifetime.Cancel();
        if (_updateWork is not null) await _updateWork;
        _lifetime.Dispose();
        if (_orderModule is not null) try { await _orderModule.InvokeVoidAsync("disconnectOrder", _root); await _orderModule.DisposeAsync(); } catch (JSDisconnectedException) { }
        _reference?.Dispose();
        if (_module is not null) try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
