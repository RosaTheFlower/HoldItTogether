@using HoldItTogether.Services.Extensions
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject ExtensionStore Store
@inject ExtensionUi Ui
@inject IJSRuntime JS

<dialog @ref="_dialog" class="theme-delete-dialog hit-confirm" aria-labelledby="downgrade-title" @oncancel="Cancel" @onwheel:stopPropagation="true" @onclick:stopPropagation="true">
    <h2 id="downgrade-title">@Text.Get("Downgrade extension?")</h2>
    <p>@Text.Format("Install {0} {1} instead of {2}? Saved data will be kept, but older extensions may not understand newer data.", _name, _target, _current)</p>
    <div class="dialog-actions">
        <button type="button" data-dialog-cancel @onclick="Cancel">@Text.Get("Cancel")</button>
        <button type="button" class="is-primary" @onclick="Confirm">@Text.Get("Downgrade")</button>
    </div>
</dialog>

@code {
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private TaskCompletionSource<bool>? _pending;
    private string _name = "", _target = "", _current = "";
    private bool _disposed;
    protected override void OnInitialized() => Store.ConfirmDowngradeAsync = RequestAsync;
    private async Task<bool> RequestAsync(ExtensionManifest current, ExtensionManifest target, CancellationToken token)
    {
        var completion = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
        await InvokeAsync(() => { if (_disposed) { completion.TrySetResult(false); return; } Ui.Open(); _name = target.Name; _target = target.Version; _current = current.Version; _pending = completion; StateHasChanged(); });
        try { return await completion.Task.WaitAsync(token); }
        finally { await InvokeAsync(() => { _pending = null; if (!_disposed) StateHasChanged(); }); }
    }
    private void Cancel() => _pending?.TrySetResult(false);
    private void Confirm() => _pending?.TrySetResult(true);
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/hit-themes.js");
        await _module.InvokeVoidAsync("setDeleteDialog", _dialog, _pending is not null);
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true; Store.ConfirmDowngradeAsync = null; Cancel();
        if (_module is not null) try { await _module.InvokeVoidAsync("setDeleteDialog", _dialog, false); await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
