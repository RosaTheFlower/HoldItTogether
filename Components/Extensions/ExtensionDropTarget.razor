@using Microsoft.JSInterop
@using HoldItTogether.Services.Extensions
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ExtensionStore Store
@inject ExtensionUi Ui
@code {
    private IJSObjectReference? _module;
    private DotNetObjectReference<ExtensionDropTarget>? _reference;
    private readonly CancellationTokenSource _lifetime = new();
    private bool _busy, _disposed;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/hit-extensions.js");
        if (_disposed) { await _module.DisposeAsync(); return; }
        _reference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("connectDrop", _reference);
    }
    [JSInvokable] public async Task ImportDropped(IJSStreamReference reference, string filename)
    {
        await using (reference)
        {
            if (_busy || _disposed) return;
            _busy = true; Ui.Open(); Ui.Report("Installing extension…");
            try
            {
                await using var stream = await reference.OpenReadStreamAsync(ExtensionStore.MaxPackageBytes, _lifetime.Token);
                var package = await Store.InstallAsync(stream, filename, _lifetime.Token);
                Ui.Report($"{package.Manifest.Name} installed. Restart HIT to activate it.");
            }
            catch (OperationCanceledException) { }
            catch (Exception error) { Ui.Report("Installation failed: " + error.GetBaseException().Message, true); }
            finally { _busy = false; }
        }
    }
    [JSInvokable] public void DropError(string message) { Ui.Open(); Ui.Report(message, true); }
    public async ValueTask DisposeAsync()
    {
        _disposed = true; _lifetime.Cancel(); _lifetime.Dispose();
        if (_module is not null) try { await _module.InvokeVoidAsync("disconnectDrop"); await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
        _reference?.Dispose();
    }
}
