@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using HoldItTogether.Services.Themes
@using HoldItTogether.Services.Settings
@using HoldItTogether.Services.HitMenus
@implements IAsyncDisposable
@inject HitThemeService Themes
@inject HitSettingsService Settings
@inject IJSRuntime JS

<div class="theme-picker" data-no-drag>
    <HitDisclosure Title="@Text.Get("Themes")" PanelId="theme-options" CssClass="theme-settings" ExpandedChanged="OnExpandedChanged">
        <MainControl>
            <select @ref="_themeSelect" aria-label="@Text.Get("HIT theme")" value="@Settings.Current.Theme" @onchange="SelectTheme">
                @foreach (var theme in _themes)
                {
                    <option value="@theme.Id">@theme.Name</option>
                }
            </select>
        </MainControl>
        <ChildContent>
            <div class="theme-buttons">
                <label class="theme-button import-theme">
                    @Text.Get("Import CSS")
                    <InputFile accept=".css,text/css" OnChange="ImportTheme" aria-label="@Text.Get("Import CSS theme")" />
                </label>
                <button type="button" @onclick="OpenFolder">@Text.Get("Open folder")</button>
                <button type="button" disabled="@(!CanDelete)" aria-label="@Text.Get("Delete theme")" @onclick="RequestDelete">@Text.Get("Delete")</button>
            </div>
        </ChildContent>
    </HitDisclosure>
    <dialog @ref="_deleteDialog" class="theme-delete-dialog" aria-labelledby="delete-theme-title"
            aria-describedby="delete-theme-description" @onwheel:stopPropagation="true" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
        <h2 id="delete-theme-title">@Text.Get("Delete theme?")</h2>
        <p id="delete-theme-description">“@_pendingDeleteName” will be permanently deleted.</p>
        <div class="dialog-actions">
            <button type="button" data-dialog-cancel aria-label="@Text.Get("Cancel deletion")" @onclick="CancelDelete">@Text.Get("Cancel")</button>
            <button type="button" class="confirm-delete" aria-label="@Text.Get("Confirm theme deletion")" @onclick="ConfirmDelete">@Text.Get("Delete")</button>
        </div>
    </dialog>
    @if ((_error ?? _runtimeError) is { Length: > 0 } error)
    {
        <p class="settings-error" role="alert">@error</p>
    }
</div>
@code {
    [CascadingParameter(Name = "HitMenu")] public HitMenuContext? MenuContext { get; set; }
    private IReadOnlyList<HitThemeOption> _themes = [];
    private readonly CancellationTokenSource _lifetime = new();
    private Task? _monitor;
    private string? _error;
    private string? _runtimeError;
    private bool _disposed;
    private string? _pendingDeleteId;
    private string? _pendingDeleteName;
    private ElementReference _themeSelect;
    private ElementReference _deleteDialog;
    private bool _dialogVisible;
    private IJSObjectReference? _module;
    private bool CanDelete => _themes.Any(theme => theme.Id == Settings.Current.Theme && theme.CanDelete);

    protected override void OnInitialized()
    {
        Refresh();
        Settings.Changed += SettingsChanged;
        _monitor = MonitorAsync(_lifetime.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var visible = _pendingDeleteId is not null;
        if (visible == _dialogVisible) return;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/hit-themes.js");
        await _module.InvokeVoidAsync("setDeleteDialog", _deleteDialog, visible);
        _dialogVisible = visible;
    }

    private void Refresh()
    {
        try
        {
            var themes = Themes.GetThemes();
            if (!_themes.SequenceEqual(themes)) _themes = themes;
            _runtimeError = Themes.RuntimeError;
            if (_pendingDeleteId is not null &&
                (_pendingDeleteId != Settings.Current.Theme || !CanDelete)) CancelDelete();
        }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException)
        { _error = Text.Get("Could not access the themes folder."); }
    }

    private void SettingsChanged()
    {
        if (!_disposed) _ = InvokeAsync(() => { Refresh(); StateHasChanged(); });
    }

    private async Task MonitorAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
                if ((MenuContext?.IsActive ?? true) && (MenuContext?.IsVisible ?? true))
                    await InvokeAsync(() =>
                    {
                        var previous = _themes;
                        var error = _error ?? _runtimeError;
                        var pending = _pendingDeleteId;
                        Refresh();
                        if (!ReferenceEquals(previous, _themes) || error != (_error ?? _runtimeError) || pending != _pendingDeleteId) StateHasChanged();
                    });
        }
        catch (OperationCanceledException) { }
    }

    private void Run(Action action)
    {
        _error = null;
        try { action(); }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException or
            ArgumentException or InvalidOperationException or System.ComponentModel.Win32Exception)
        { _error = error.Message; }
        Refresh();
    }

    private async Task SelectTheme(ChangeEventArgs args)
    {
        CancelDelete();
        Run(() => Themes.Select(args.Value?.ToString() ?? "default"));
        // Release the native combobox after choosing, so wheel navigation resumes immediately.
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/hit-themes.js");
        await _module.InvokeVoidAsync("releaseFocus", _themeSelect);
    }
    private void OpenFolder() => Run(Themes.OpenFolder);
    private void RequestDelete()
    {
        if (!CanDelete) return;
        _pendingDeleteId = Settings.Current.Theme;
        _pendingDeleteName = _themes.First(theme => theme.Id == _pendingDeleteId).Name;
    }

    private void CancelDelete() { _pendingDeleteId = null; _pendingDeleteName = null; }
    private void OnExpandedChanged(bool expanded) { if (!expanded) CancelDelete(); }

    private void ConfirmDelete()
    {
        var id = _pendingDeleteId;
        CancelDelete();
        if (id is not null && id == Settings.Current.Theme && CanDelete)
            Run(() => Themes.Delete(id));
    }

    private async Task ImportTheme(InputFileChangeEventArgs args)
    {
        _error = null;
        try
        {
            await using var stream = args.File.OpenReadStream(HitThemeService.MaxCssBytes);
            var id = await Themes.ImportAsync(args.File.Name, stream);
            Themes.Select(id);
        }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException or ArgumentException or InvalidOperationException)
        { _error = error.Message; }
        Refresh();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Settings.Changed -= SettingsChanged;
        _lifetime.Cancel();
        if (_monitor is not null) await _monitor;
        _lifetime.Dispose();
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
