@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using HoldItTogether.Services.Themes
@using HoldItTogether.Services.Settings
@using HoldItTogether.Services.HitMenus
@using HoldItTogether.Services.Extensions
@implements IAsyncDisposable
@inject HitThemeService Themes
@inject HitSettingsService Settings
@inject ExtensionUi Ui
@inject IJSRuntime JS

<div class="theme-picker @(Detailed ? "theme-manager" : "theme-quick-picker")" data-no-drag>
@if (Detailed)
{
    @if(ShowSections){
    <nav class="appearance-actions" aria-label="Themes sections">
        <button type="button" class="hit-button" aria-label="Show installed themes" aria-pressed="@(!_personalizing ? "true" : "false")" @onclick="ClosePersonalizationAsync">Installed themes</button>
        <button type="button" class="hit-button" aria-label="Open theme personalization" aria-pressed="@(_personalizing ? "true" : "false")" @onclick="()=>_personalizing=true">Personalization</button>
    </nav>
    }
    @if(_personalizing)
    {
        <HoldItTogether.Components.Settings.AppearanceView BackLabel="Themes" BackRequested="ClosePersonalizationAsync" />
    }
    else
    {
    @if (ShowBack) { <button type="button" class="hit-back" @onclick="BackRequested"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m11 5-5 5 5 5M6 10h10" /></svg>Settings</button> }
    <p class="hit-muted">Click to select. Ctrl + click to select several. Double-click or press Enter to activate.</p>
    <div class="theme-list" role="listbox" aria-label="Installed themes" aria-multiselectable="true" data-hit-scroll tabindex="0">
        @foreach (var theme in _themes)
        {
            <button @key="theme.Id" type="button" role="option" data-theme-id="@theme.Id" class="theme-list-item @(_selected.Contains(theme.Id) ? "is-selected" : "")" aria-selected="@(_selected.Contains(theme.Id) ? "true" : "false")" @onclick="args => SelectItem(theme.Id, args.CtrlKey)" @ondblclick="() => Activate(theme.Id)" @onkeydown="args => ActivateKey(args, theme.Id)">
                <span>@theme.Name<small>@(theme.CanDelete ? "Personal theme" : "Built-in")</small></span><span class="theme-active">@(Settings.Current.Theme == theme.Id ? "Active" : "")</span>
            </button>
        }
    </div>
    <div class="theme-buttons"><button type="button" @onclick="OpenFolder">Open folder</button><button type="button" disabled="@(!CanDelete)" aria-label="Delete selected themes" @onclick="RequestDelete">Delete selected</button></div>
    <label class="hit-button theme-import-row import-theme" aria-busy="@(_importing ? "true" : "false")" title="@Text.Get("Import a local CSS file as a theme.")">@if(_importing){<HitSpinner Label="@Text.Get("Importing theme")" />}else{@Text.Get("Import CSS")}<InputFile disabled="@_importing" accept=".css,text/css" OnChange="ImportTheme" aria-label="Import CSS theme" /></label>
    <dialog @ref="_deleteDialog" class="theme-delete-dialog hit-confirm" aria-labelledby="delete-theme-title" @oncancel="CancelDelete" @onwheel:stopPropagation="true" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true" @oncontextmenu="CancelDelete" @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
        <h2 id="delete-theme-title">@(_pending.Length == 1 ? "Delete theme?" : "Delete themes?")</h2>
        <p>@(_pending.Length == 1 ? $"“{_pending[0].Name}” will be permanently deleted." : $"{_pending.Length} personal themes will be permanently deleted.")</p>
        <div class="dialog-actions"><button type="button" data-dialog-cancel @onclick="CancelDelete">Cancel</button><button type="button" class="is-primary" aria-label="Confirm theme deletion" @onclick="ConfirmDelete">Delete</button></div>
    </dialog>
    @if (Ui.Message is not null) { <p class="hit-muted" role="status">@if(Ui.IsBusy){<HitSpinner Label="@Ui.Message" />}else{@Ui.Message}</p> }
    }
}
else
{
    <select @ref="_themeSelect" aria-label="HIT theme" value="@Settings.Current.Theme" data-hit-select-value="@Settings.Current.Theme" @onchange="SelectTheme">
        @foreach (var theme in _themes) { <option value="@theme.Id">@theme.Name</option> }
    </select>
}
@if ((_error ?? Themes.RuntimeError) is { Length: > 0 } error) { <p class="settings-error" role="alert">@error</p> }
</div>
@code {
    [Parameter] public bool ShowSections {get;set;}=true;
    [Parameter] public bool Detailed { get; set; }
    private bool _importing;
    [Parameter] public bool ShowBack { get; set; } = true;
    [Parameter] public EventCallback BackRequested { get; set; }
    [CascadingParameter(Name = "HitMenu")] public HitMenuContext? MenuContext { get; set; }
    private IReadOnlyList<HitThemeOption> _themes = [];
    private readonly HashSet<string> _selected = [];
    private HitThemeOption[] _pending = [];
    private readonly CancellationTokenSource _lifetime = new();
    private Task? _monitor;
    private IJSObjectReference? _module;
    private ElementReference _themeSelect, _deleteDialog;
    private bool _disposed, _dialogVisible;
    private bool _personalizing;
    public bool IsPersonalizing=>_personalizing;
    public Task ClosePersonalizationAsync()=>InvokeAsync(()=>{_personalizing=false;StateHasChanged();});
    private string? _error, _runtimeError;
    private bool CanDelete => _themes.Any(theme => _selected.Contains(theme.Id) && theme.CanDelete);
    protected override void OnInitialized()
    {
        Refresh(); _selected.Add(Ui.SelectedThemeId ?? Settings.Current.Theme);
        Settings.Changed += Changed; Ui.OpenRequested += OpenRequested; Ui.Changed += Changed; _monitor = MonitorAsync(_lifetime.Token);
    }
    private void OpenRequested() { if (!_disposed && Ui.ShowThemes) _ = InvokeAsync(() => { _personalizing=false; Refresh(); _selected.Clear(); _selected.Add(Ui.SelectedThemeId ?? Settings.Current.Theme); StateHasChanged(); }); }
    private void Changed() { if (!_disposed) _ = InvokeAsync(() => { Refresh(); StateHasChanged(); }); }
    private void Refresh()
    {
        try { var themes = Themes.GetThemes(); if (!_themes.SequenceEqual(themes)) _themes = themes; _runtimeError = Themes.RuntimeError; _selected.RemoveWhere(id => !_themes.Any(theme => theme.Id == id)); }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException) { _error = "Could not access the themes folder."; }
    }
    private async Task MonitorAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try { while (await timer.WaitForNextTickAsync(token)) if (MenuContext?.IsVisible ?? true) await InvokeAsync(() => { var previous = _themes; var error = _runtimeError; Refresh(); if (!ReferenceEquals(previous, _themes) || error != _runtimeError) StateHasChanged(); }); }
        catch (OperationCanceledException) { }
    }
    private void Run(Action action)
    {
        _error = null;
        try { action(); }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException or ArgumentException or InvalidOperationException or System.ComponentModel.Win32Exception) { _error = error.Message; }
        Refresh();
    }
    private void SelectItem(string id, bool multiple) { if (!multiple) _selected.Clear(); if (!_selected.Add(id) && multiple) _selected.Remove(id); }
    private void Activate(string id) => Run(() => Themes.Select(id));
    private void ActivateKey(KeyboardEventArgs args, string id) { if (args.Key == "Enter") Activate(id); }
    private async Task SelectTheme(ChangeEventArgs args)
    {
        Activate(args.Value?.ToString() ?? "default");
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/hit-themes.js");
        await _module.InvokeVoidAsync("releaseFocus", _themeSelect);
    }
    private void OpenFolder() => Run(Themes.OpenFolder);
    private void RequestDelete() => _pending = _themes.Where(theme => theme.CanDelete && _selected.Contains(theme.Id)).ToArray();
    private void CancelDelete() => _pending = [];
    private void ConfirmDelete() { var pending = _pending; _pending = []; Run(() => { foreach (var theme in pending) Themes.Delete(theme.Id); }); }
    private async Task ImportTheme(InputFileChangeEventArgs args)
    {
        if(_importing||_disposed)return;_importing=true;
        try { await using var stream = args.File.OpenReadStream(HitThemeService.MaxCssBytes, _lifetime.Token); var id = await Themes.ImportAsync(args.File.Name, stream); Refresh(); _selected.Clear(); _selected.Add(id); }
        catch (OperationCanceledException) { }
        catch (Exception error) when (error is IOException or UnauthorizedAccessException or ArgumentException or InvalidOperationException) { _error = error.Message; }
        finally { _importing=false; }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Detailed || _dialogVisible == (_pending.Length > 0)) return;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/hit-themes.js");
        await _module.InvokeVoidAsync("setDeleteDialog", _deleteDialog, _pending.Length > 0); _dialogVisible = _pending.Length > 0;
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true; Settings.Changed -= Changed; Ui.OpenRequested -= OpenRequested; Ui.Changed -= Changed;
        _lifetime.Cancel(); if (_monitor is not null) await _monitor; _lifetime.Dispose();
        if (_module is not null) try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
