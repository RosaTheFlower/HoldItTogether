@using HoldItTogether.Services.Clock

<section class="clock-settings" aria-label="@Text.Get("Clock settings")" data-no-drag>
    <button type="button" class="clock-back" @onclick="() => BackRequested.InvokeAsync()" aria-label="@Text.Get("Back to Clock")">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m11 5-5 5 5 5M6 10h10" /></svg>@Text.Get("Clock")
    </button>
    <label class="clock-setting-row">
        <span>@Text.Get("Show seconds")<small>@Text.Get("On the system clock, including compact mode.")</small></span>
        <input class="clock-switch switch" type="checkbox" role="switch" aria-label="@Text.Get("Show clock seconds")"
               checked="@Options.ShowSeconds" @onchange="args => Change(value => value with { ShowSeconds = args.Value is true })" />
    </label>
    <label class="clock-setting-row">
        <span>@Text.Get("Show two clocks")<small>@Text.Get("The first two world clocks, including compact mode.")</small></span>
        <input class="clock-switch switch" type="checkbox" role="switch" aria-label="@Text.Get("Show two system clocks")"
               checked="@Options.ShowTwoClocks" @onchange="args => Change(value => value with { ShowTwoClocks = args.Value is true })" />
    </label>
    <label class="clock-setting-row">
        <span>@Text.Get("Notification sounds")<small>@Text.Get("When a timer or a Pomodoro phase ends.")</small></span>
        <input class="clock-switch switch" type="checkbox" role="switch" aria-label="@Text.Get("Clock notification sounds")"
               checked="@Options.SoundEnabled" @onchange="args => Change(value => value with { SoundEnabled = args.Value is true })" />
    </label>
    <HitDisclosure Title="@Text.Get("Pomodoro")" PanelId="clock-pomodoro-options" CssClass="clock-disclosure">
        <MainControl><span class="clock-setting-summary">@Options.FocusMinutes / @Options.ShortBreakMinutes min</span></MainControl>
        <ChildContent>
            <label class="clock-setting-number"><span>@Text.Get("Focus")</span><input type="number" min="1" max="180" value="@Options.FocusMinutes" aria-label="@Text.Get("Focus minutes")"
                @onchange="args => SetNumber(args, (value, number) => value with { FocusMinutes = number })" @onwheel:stopPropagation="true" /><span>@Text.Get("min")</span></label>
            <label class="clock-setting-number"><span>@Text.Get("Short break")</span><input type="number" min="1" max="60" value="@Options.ShortBreakMinutes" aria-label="@Text.Get("Short break minutes")"
                @onchange="args => SetNumber(args, (value, number) => value with { ShortBreakMinutes = number })" @onwheel:stopPropagation="true" /><span>@Text.Get("min")</span></label>
            <label class="clock-setting-number"><span>@Text.Get("Long break")</span><input type="number" min="1" max="120" value="@Options.LongBreakMinutes" aria-label="@Text.Get("Long break minutes")"
                @onchange="args => SetNumber(args, (value, number) => value with { LongBreakMinutes = number })" @onwheel:stopPropagation="true" /><span>@Text.Get("min")</span></label>
            <label class="clock-setting-number"><span>@Text.Get("Long break every")</span><input type="number" min="2" max="12" value="@Options.RoundsBeforeLongBreak" aria-label="@Text.Get("Rounds before a long break")"
                @onchange="args => SetNumber(args, (value, number) => value with { RoundsBeforeLongBreak = number })" @onwheel:stopPropagation="true" /><span>@Text.Get("sessions")</span></label>
            <label class="clock-setting-row"><span>@Text.Get("Continue automatically")</span>
                <input class="clock-switch switch" type="checkbox" role="switch" aria-label="@Text.Get("Continue Pomodoro cycles automatically")" checked="@Options.AutoContinue"
                       @onchange="args => Change(value => value with { AutoContinue = args.Value is true })" /></label>
        </ChildContent>
    </HitDisclosure>
    @if (Error is { } error) { <p class="clock-error" role="status">@error</p> }
</section>
@code {
    [Parameter, EditorRequired] public ClockPreferences Options { get; set; } = new();
    [Parameter] public EventCallback<ClockPreferences> Changed { get; set; }
    [Parameter] public EventCallback BackRequested { get; set; }
    [Parameter] public string? Error { get; set; }
    private Task Change(Func<ClockPreferences, ClockPreferences> change) => Changed.InvokeAsync(change(Options).Normalize());
    private Task SetNumber(ChangeEventArgs args, Func<ClockPreferences, int, ClockPreferences> change) =>
        int.TryParse(args.Value?.ToString(), out var number) ? Change(value => change(value, number)) : Task.CompletedTask;
}
