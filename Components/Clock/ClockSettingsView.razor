@using HoldItTogether.Services.Clock
@using HoldItTogether.Components.Settings
<section class="clock-settings" aria-label="@Text.Get("Clock settings")" data-no-drag>
@if (Topic == "Pomodoro")
{
    <SettingRange Label="Focus minutes" Description="Duration of each Pomodoro focus phase." Value="Options.FocusMinutes" Min="1" Max="180" Unit="min" Changed="v => Change(o => o with { FocusMinutes = (int)v })" />
    <SettingRange Label="Short break minutes" Description="Duration of the short break between focus phases." Value="Options.ShortBreakMinutes" Min="1" Max="60" Unit="min" Changed="v => Change(o => o with { ShortBreakMinutes = (int)v })" />
    <SettingRange Label="Long break minutes" Description="Duration of the recovery break after a group of focus phases." Value="Options.LongBreakMinutes" Min="1" Max="120" Unit="min" Changed="v => Change(o => o with { LongBreakMinutes = (int)v })" />
    <SettingRange Label="Rounds before a long break" Description="Number of focus phases before a long break." Value="Options.RoundsBeforeLongBreak" Min="2" Max="12" Unit="sessions" Changed="v => Change(o => o with { RoundsBeforeLongBreak = (int)v })" />
    <SettingToggle Label="Continue Pomodoro cycles automatically" Description="Start the next focus or break phase without another click." Value="Options.AutoContinue" Changed="v => Change(o => o with { AutoContinue = v })" />
}
else
{
    <SettingToggle Label="Show clock seconds" Description="Display seconds on system clocks, including compact mode." Value="Options.ShowSeconds" Changed="v => Change(o => o with { ShowSeconds = v })" />
    <SettingToggle Label="Show two system clocks" Description="Show the first two world clocks, including compact mode." Value="Options.ShowTwoClocks" Changed="v => Change(o => o with { ShowTwoClocks = v })" />
    <SettingToggle Label="Clock notification sounds" Description="Play a sound when a timer or Pomodoro phase ends." Value="Options.SoundEnabled" Changed="v => Change(o => o with { SoundEnabled = v })" />
}
@if (Error is { } error) { <p class="clock-error" role="status">@error</p> }
</section>
@code {
    [Parameter] public string Topic { get; set; } = "General";
    [Parameter, EditorRequired] public ClockPreferences Options { get; set; } = new();
    [Parameter] public EventCallback<ClockPreferences> Changed { get; set; }
    [Parameter] public string? Error { get; set; }
    private Task Change(Func<ClockPreferences, ClockPreferences> change) => Changed.InvokeAsync(change(Options).Normalize());
}
