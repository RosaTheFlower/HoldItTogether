@using HoldItTogether.Services.HitMenus
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject HoldItTogether.Services.Extensions.ExtensionStore Store
@code {
    [Parameter, EditorRequired] public HitMenuDefinition Menu { get; set; } = default!;
    [CascadingParameter(Name = "HitExtension")] public HIT.Sdk.HitContext? Context { get; set; }
    private IJSObjectReference? _module;
    private readonly CancellationTokenSource _lifetime = new();
    private Task? _monitor;
    private bool _disposed;
    private string? _revision;
    private async Task ApplyAsync()
    {
        if (_disposed || _module is null) return;
        var files = Menu.Styles.Select(url =>
        {
            var parts = url.Split('/', 4);
            var path = HoldItTogether.Services.Extensions.ExtensionManifest.SafePath(Path.Combine(Store.Root, "Installed", parts[1], parts[2]), Uri.UnescapeDataString(parts[3]));
            return (Url: url, File: new FileInfo(path));
        }).ToArray();
        var revision = string.Join('|', files.Select(item => $"{item.File.Length}:{item.File.LastWriteTimeUtc.Ticks}"));
        if (_revision == revision) return;
        if (files.Any(item => item.File.Length > 1024 * 1024)) return;
        await _module.InvokeVoidAsync("styles", Menu.Id, files.Select(item => new { url = item.Url, css = File.ReadAllText(item.File.FullName) }).ToArray());
        _revision = revision;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/hit-extensions.js");
        if (_disposed) { await _module.DisposeAsync(); return; }
        await ApplyAsync();
        _monitor = MonitorAsync(_lifetime.Token);
    }
    private async Task MonitorAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
                if (Context?.IsVisible == true)
                    try { await InvokeAsync(ApplyAsync); }
                    catch (Exception error) when (error is IOException or UnauthorizedAccessException or JSException) { /* Keep the last valid CSS during edits. */ }
        }
        catch (OperationCanceledException) { }
        catch (JSDisconnectedException) { }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true; _lifetime.Cancel();
        if (_monitor is not null) await _monitor;
        _lifetime.Dispose();
        if (_module is not null) try { await _module.InvokeVoidAsync("removeStyles", Menu.Id); await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
