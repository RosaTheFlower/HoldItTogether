@using HoldItTogether.Services.HitMenus
@using HoldItTogether.Services.Settings
@inject HitMenuCatalog Catalog
@inject HitSettingsService Settings
@implements IDisposable

<div class="hit-menu-host @(CurrentLayout == HitMenuLayout.Compact ? "is-compact" : "")"
     data-hit-configuration="@(_selectedId == HitMenuCatalog.SettingsId || CurrentSettings?.IsSettingsOpen == true ? "true" : "false")"
     @onpointerdown="RememberContextStart" @oncontextmenu="ReturnFromSettingsAsync"
     @oncontextmenu:preventDefault="true" @oncontextmenu:stopPropagation="true">
    <div class="hit-menu-measure">
        @if (Catalog.Menus.Count == 0)
        {
            <div class="hit-menu-empty">@Text.Get("No menus available.")</div>
        }
        else
        {
            @for (var index = 0; index < Catalog.Menus.Count; index++)
            {
                var menu = Catalog.Menus[index];
                var active = index == _navigation.SelectedIndex;
                var contextId = menu.Id;
                @if (_visited.Contains(menu.Id))
                {
                    <section @key="menu.Id" class="hit-menu-panel"
                             hidden="@(!active)" inert="@(!active)"
                             aria-hidden="@(!active ? "true" : "false")"
                             aria-label="@menu.Name" data-hit-menu="@menu.Id">
                        <CascadingValue Name="HitMenu" Value="@(new HitMenuContext(active, OnCloseRequested, active && IsVisible,
                            EventCallback.Factory.Create<string>(this, title => RequestTitleAsync(contextId, title)), IsPinned,
                            EventCallback.Factory.Create<HitMenuLayout>(this, layout => RequestLayoutAsync(contextId, layout)), IsVisible))">
                            @if (menu.Api is null)
                            {
                                <DynamicComponent @ref="_components[contextId]" Type="@menu.ComponentType" />
                            }
                            else
                            {
                                <CascadingValue Name="HitExtension" Value="@(ExtensionContext(menu, active))">
                                    <ExtensionErrorBoundary @key="menu.Id" Api="menu.Api" OnFailure="_ => ExtensionFailedAsync(contextId)">
                                        <ChildContent>
                                            <ExtensionStyles Menu="menu">
                                                <DynamicComponent @ref="_components[contextId]" Type="@menu.ComponentType" Parameters="@(new Dictionary<string, object> { ["Api"] = menu.Api })" />
                                            </ExtensionStyles>
                                        </ChildContent>
                                        <ErrorContent><p class="settings-error" role="alert">@Text.Get("This extension could not display its menu. Disable it in Extensions and check its compatibility.")</p></ErrorContent>
                                    </ExtensionErrorBoundary>
                                </CascadingValue>
                            }
                        </CascadingValue>
                    </section>
                }
            }
        }
    </div>

    @if (Catalog.Menus.Count > 0)
    {
        <nav class="hit-menu-pagination" aria-label="@Text.Get("HIT menus")" data-no-drag hidden="@(CurrentLayout == HitMenuLayout.Compact)"
             @onclick:stopPropagation="true"
             @onkeydown="HandlePaginationKey" @onkeydown:stopPropagation="true">
            @for (var index = 0; index < Catalog.Menus.Count; index++)
            {
                var menuIndex = index;
                var menu = Catalog.Menus[index];
                var active = index == _navigation.SelectedIndex;
                <button type="button" class="hit-menu-dot @(active ? "is-current" : "")"
                        aria-label="@($"Menu {index + 1} of {Catalog.Menus.Count}: {menu.Name}")"
                        aria-current="@(active ? "page" : null)" title="@menu.Name"
                        @onclick="() => SelectMenuAsync(menuIndex)">
                    <span aria-hidden="true"></span>
                </button>
            }
        </nav>
    }
</div>

@code {
    [Parameter] public bool IsVisible { get; set; } = true;
    [Parameter] public bool IsPinned { get; set; }
    [Parameter] public EventCallback OnCloseRequested { get; set; }
    [Parameter] public EventCallback<string> OnTitleChanged { get; set; }
    [Parameter] public EventCallback<bool> OnSettingsAvailableChanged { get; set; }
    [Parameter] public EventCallback<HitMenuLayout> OnLayoutChanged { get; set; }
    [Parameter] public EventCallback<bool> OnPinRequested { get; set; }
    private string? _selectedId;
    private string CurrentTitle => _selectedId is not null && _titles.TryGetValue(_selectedId, out var title) ? title : Catalog.Menus.FirstOrDefault(menu => menu.Id == _selectedId)?.Name ?? "HIT";
    private readonly Dictionary<string, string> _titles = [];
    private HitMenuNavigator _navigation = new(0);
    private readonly HashSet<string> _visited = [];
    private readonly Dictionary<string, DynamicComponent> _components = [];
    private readonly Dictionary<string, HitMenuLayout> _layouts = [];
    private readonly HashSet<string> _failedMenus = [];
    private bool _contextStartedInSettings;
    private HitMenuLayout CurrentLayout => _selectedId is null ? HitMenuLayout.Default : _layouts.GetValueOrDefault(_selectedId);
    private bool CurrentHasSettings => !_disposed && _selectedId != HitMenuCatalog.SettingsId && !_failedMenus.Contains(_selectedId ?? "") &&
        Catalog.Menus.FirstOrDefault(menu => menu.Id == _selectedId)?.ComponentType is { } type &&
        typeof(HIT.Sdk.IHitMenuSettings).IsAssignableFrom(type);

    private HIT.Sdk.IHitMenuSettings? CurrentSettings => !_disposed && !_failedMenus.Contains(_selectedId ?? "") &&
        _components.TryGetValue(_selectedId ?? "", out var component) && component.Instance is HIT.Sdk.IHitMenuSettings settings
            ? settings : null;
    private HIT.Sdk.IHitMenuCompact? CurrentCompact => !_disposed && !_failedMenus.Contains(_selectedId ?? "") &&
        _components.TryGetValue(_selectedId ?? "", out var component) ? component.Instance as HIT.Sdk.IHitMenuCompact : null;
    public async Task<bool> CompactCurrentAsync()
    {
        if (CurrentSettings?.IsSettingsOpen == true || CurrentCompact is not { } compact) return false;
        var id = _selectedId;
        await OnPinRequested.InvokeAsync(true);
        if (_disposed || id != _selectedId) return false;
        await compact.CompactNowAsync();return true;
    }

    public Task OpenCurrentSettingsAsync() => CurrentHasSettings && CurrentSettings is { } settings
        ? settings.OpenSettingsAsync() : Task.CompletedTask;

    private async Task ExtensionFailedAsync(string menuId)
    {
        if (_disposed) return;
        // Error boundaries unmount their children; never retain a callable instance.
        _failedMenus.Add(menuId);
        _components.Remove(menuId);
        _layouts.Remove(menuId);
        _titles.Remove(menuId);
        if (menuId == _selectedId) await PublishMenuAsync();
    }

    private void RememberContextStart(PointerEventArgs args)
    {
        if (args.Button == 2) _contextStartedInSettings = CurrentSettings is { IsSettingsOpen: true };
    }

    private Task ReturnFromSettingsAsync(MouseEventArgs args)
    {
        var canReturn = _contextStartedInSettings;
        _contextStartedInSettings = false;
        // Opening a configuration with this same right-click must never close it again.
        return canReturn && CurrentSettings is { IsSettingsOpen: true } settings
                ? settings.CloseSettingsAsync() : Task.CompletedTask;
    }

    private async Task PublishMenuAsync()
    {
        await OnTitleChanged.InvokeAsync(CurrentTitle);
        await OnSettingsAvailableChanged.InvokeAsync(CurrentHasSettings);
        await OnLayoutChanged.InvokeAsync(CurrentLayout);
    }

    protected override async Task OnInitializedAsync()
    {
        Catalog.Changed += CatalogChanged;
        _navigation = new HitMenuNavigator(Catalog.Menus.Count);
        _selectedId = Catalog.Menus.FirstOrDefault()?.Id;
        if (_selectedId is not null) _visited.Add(_selectedId);
        await PublishMenuAsync();
    }

    public async Task HandleWheelAsync(WheelEventArgs args)
    {
        if (CurrentSettings is { IsSettingsOpen: true }) return;
        if (_navigation.Scroll(args.DeltaX, args.DeltaY, args.DeltaMode, args.CtrlKey,
                               Environment.TickCount64, Settings.Current))
        {
            _selectedId = Catalog.Menus[_navigation.SelectedIndex].Id;
            _visited.Add(_selectedId);
            await PublishMenuAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SelectMenuAsync(int index)
    {
        if (_navigation.Select(index))
        {
            _selectedId = Catalog.Menus[index].Id;
            _visited.Add(_selectedId);
            await PublishMenuAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task RequestTitleAsync(string menuId, string title) =>
        SetTitleAsync(menuId, title);
    private Task SetTitleAsync(string menuId, string title)
    {
        if (_disposed || _failedMenus.Contains(menuId) || menuId != _selectedId) return Task.CompletedTask;
        _titles[menuId] = title.Length > 100 ? title[..100] : title;
        return OnTitleChanged.InvokeAsync(_titles[menuId]);
    }

    private async Task RequestLayoutAsync(string menuId, HitMenuLayout layout)
    {
        if (_disposed || _failedMenus.Contains(menuId) || menuId != _selectedId || CurrentLayout == layout) return;
        _layouts[menuId] = layout;
        await OnLayoutChanged.InvokeAsync(layout);
    }

    private Task HandlePaginationKey(KeyboardEventArgs args) =>
        args.Key == "Escape" ? OnCloseRequested.InvokeAsync() : Task.CompletedTask;
    private bool _disposed;
    private void CatalogChanged()
    {
        if (!_disposed) _ = InvokeAsync(async () =>
        {
            var ids = Catalog.Menus.Select(menu => menu.Id).ToHashSet();
            _visited.RemoveWhere(id => !ids.Contains(id));
            _failedMenus.RemoveWhere(id => !ids.Contains(id));
            foreach (var id in _components.Keys.Where(id => !ids.Contains(id)).ToArray()) { _components.Remove(id); _layouts.Remove(id); _titles.Remove(id); }
            _navigation = new HitMenuNavigator(Catalog.Menus.Count);
            var next = Catalog.Menus.ToList().FindIndex(menu => menu.Id == _selectedId);
            if (next < 0) next = Math.Max(0, Catalog.Menus.ToList().FindIndex(menu => menu.Id == HitMenuCatalog.SettingsId));
            _navigation.Select(next);
            _selectedId = Catalog.Menus.ElementAtOrDefault(next)?.Id;
            if (_selectedId is not null) _visited.Add(_selectedId);
            await PublishMenuAsync(); StateHasChanged();
        });
    }
    public async Task ShowExtensionsAsync()
    {
        var index = Catalog.Menus.ToList().FindIndex(menu => menu.Id == HitMenuCatalog.SettingsId);
        if (index >= 0) await SelectMenuAsync(index);
    }
    private HIT.Sdk.HitContext ExtensionContext(HitMenuDefinition menu, bool active) => new(active, active && IsVisible, IsPinned,
        title => RequestTitleAsync(menu.Id, title),
        layout => RequestLayoutAsync(menu.Id, (HitMenuLayout)(int)layout),
        pinned => { if (_disposed || _failedMenus.Contains(menu.Id)) return Task.CompletedTask; menu.Api!.Demand("window.control"); return menu.Id == _selectedId && IsVisible ? OnPinRequested.InvokeAsync(pinned) : Task.CompletedTask; },
        () => { if (_disposed || _failedMenus.Contains(menu.Id)) return Task.CompletedTask; menu.Api!.Demand("window.control"); return menu.Id == _selectedId && IsVisible ? OnCloseRequested.InvokeAsync() : Task.CompletedTask; });
    public void Dispose() { _disposed = true; Catalog.Changed -= CatalogChanged; }

}
