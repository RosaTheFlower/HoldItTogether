<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Sdk/**;Examples/**;Tests/**" />
    <Content Remove="Sdk/**;Examples/**;Tests/**" />
    <None Remove="Sdk/**;Examples/**;Tests/**" />
    <RazorComponent Remove="Sdk/**;Examples/**;Tests/**" />
    <ProjectReference Include="Sdk/HIT.Sdk/HIT.Sdk.csproj" />
    <EmbeddedResource Include="Resources/en.json" />
    <PackageReference Include="Photino.Blazor" Version="4.0.13" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Docs/**/*.md"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="wwwroot/css/menus.css" />
    <Content Include="wwwroot/css/menus.css" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="GeneratePublicMenuCssIndex" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <PublicMenuCss Include="wwwroot/css/menus/*.css" />
    </ItemGroup>
    <WriteLinesToFile File="wwwroot/css/menus.css"
                      Lines="@(PublicMenuCss->'@import url(&quot;menus/%(Filename)%(Extension)&quot;)%3B')"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
