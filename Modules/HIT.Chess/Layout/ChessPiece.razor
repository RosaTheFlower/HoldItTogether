@namespace HIT.Chess.Layout

<svg class="chess-piece @(Piece > 0 ? "white-piece" : "black-piece")" viewBox="0 0 64 64" aria-hidden="true" focusable="false"
     data-chess-pending="@(Pending ? "true" : null)" style="@(Pending ? "visibility: hidden" : null)">
    <defs>
        <linearGradient id="@_gradient" x1="0" y1="0" x2="1" y2=".6" gradientUnits="objectBoundingBox">
            <stop offset="0" class="piece-shine" /><stop offset=".45" class="piece-body" /><stop offset="1" class="piece-shade" />
        </linearGradient>
    </defs>
    <g class="piece-sculpture" fill="@($"url(#{_gradient})")">
        @switch (Math.Abs(Piece))
        {
            case 1:
                <path d="M25 25c-3-2-4.5-5-4.5-8.2a11.5 11.5 0 0 1 23 0c0 3.2-1.5 6.2-4.5 8.2l-1 4H26z" />
                <path d="M26 33h12c-1 9 1.5 12 6 16l-2 3H22l-2-3c4.5-4 7-7 6-16z" />
                <path d="M23 28h18c2 0 3 1 3 2.5S43 33 41 33H23c-2 0-3-1-3-2.5s1-2.5 3-2.5z" />
                <path class="piece-engraving" d="M26 12c-3 2-4 5-3 8" />
                break;
            case 2:
                <path d="M18 49c0-9 7-13 14-19l-11 3-7 7-7-7 5-11 9-9 5-10 7 6c16-2 24 12 22 27l-3 15H18z" />
                <path d="m15 25 10-7-1-8 6 5-5 7-8 7z" class="piece-inset" />
                <path class="piece-engraving" d="M35 12c10 3 15 13 12 25M39 17l7 1m-5 4 7 2m-6 3 7 2m-6 3 6 2M17 34l5-2M30 38c5-5 8-9 7-14" />
                <circle class="piece-eye" cx="29" cy="20" r="1.65" />
                <path class="piece-engraving" d="m11 31 3-1" />
                break;
            case 3:
                <path d="M32 7c-3 7-14 12-14 22 0 6 4 10 10 11l-3 9h14l-3-9c6-1 10-5 10-11 0-10-11-15-14-22z" />
                <circle cx="32" cy="6" r="3.5" />
                <path class="piece-engraving" d="m35 16-9 12m-3 7c5 3 13 3 18 0M28 43h8" />
                <path d="M23 46c5 2 13 2 18 0l3 5H20z" />
                break;
            case 4:
                <path d="M14 8h9v8h5V8h8v8h5V8h9v17l-7 5 1 18 4 4H16l4-4 1-18-7-5z" />
                <path class="piece-engraving" d="M15 24h34M22 30h20M22 45h20M27 32v10" />
                <path d="M18 46h28v5H18z" />
                break;
            case 5:
                <path d="m12 18 10 11 3-17 7 14 7-14 3 17 10-11-8 29H20z" />
                <circle cx="11" cy="15" r="3.2" /><circle cx="24" cy="10" r="3.2" /><circle cx="40" cy="10" r="3.2" /><circle cx="53" cy="15" r="3.2" />
                <path class="piece-engraving" d="m23 34 2 8m7-10v11m9-9-2 8" />
                <path d="M20 43c8 3 16 3 24 0l1 6c-8 3-18 3-26 0z" />
                break;
            case 6:
                <path d="M29 3h6v6h6v6h-6v7h-6v-7h-6V9h6z" />
                <path d="M29 24c-6-7-18-5-17 5 0 7 8 11 10 19h20c2-8 10-12 10-19 1-10-11-12-17-5-2 2-4 2-6 0z" />
                <path class="piece-engraving" d="M19 27c-1 5 4 8 6 12m20-12c1 5-4 8-6 12M32 28v13" />
                <path d="M21 44c7 3 15 3 22 0l1 6H20z" />
                break;
        }
        <path d="M20 50h24c2 0 4 2 4 4v1H16v-1c0-2 2-4 4-4z" />
        <path d="M16 55h32c2 0 4 2 4 4v1H12v-1c0-2 2-4 4-4z" />
        <path class="piece-engraving" d="M18 57h28" />
    </g>
</svg>

@code {
    [Microsoft.AspNetCore.Components.Parameter] public int Piece { get; set; }
    [Microsoft.AspNetCore.Components.Parameter] public bool Pending { get; set; }
    private readonly string _gradient = "chess-piece-" + Guid.NewGuid().ToString("N");
}
